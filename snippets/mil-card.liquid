{% doc %}
  The Millinery — product tile on speckled paper, caps name + price beneath.

  @param {object} product - The product to show
  @param {string} [sizes] - Image sizes attribute
  @param {boolean} [lazy] - Lazy-load the image (default true)
{% enddoc %}
{%- liquid
  assign img = product.featured_media.preview_image
  assign alt_img = product.media[1].preview_image
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
  assign sizes = sizes | default: '(min-width: 900px) 25vw, 50vw'
-%}
<a class="mil-card" href="{{ product.url }}">
  <span class="mil-card__media mil-paper">
    {%- if img -%}
      {{
        img
        | image_url: width: 1000
        | image_tag:
          widths: '360, 540, 720, 1000',
          sizes: sizes,
          loading: load,
          alt: product.title,
          class: 'mil-card__img'
      }}
      {%- if alt_img -%}
        {{
          alt_img
          | image_url: width: 1000
          | image_tag:
            widths: '360, 540, 720, 1000',
            sizes: sizes,
            loading: 'lazy',
            alt: '',
            class: 'mil-card__img mil-card__img--alt'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'mil-card__img mil-card__placeholder' }}
    {%- endif -%}
  </span>
  <span class="mil-card__meta mil-caps">
    <span class="mil-card__title">{{ product.title }}</span>
    <span class="mil-card__price">
      {%- if product.available -%}
        {%- if product.price_varies -%}From {% endif -%}
        {{- product.price | money -}}
      {%- else -%}
        Sold out
      {%- endif -%}
    </span>
  </span>
</a>
