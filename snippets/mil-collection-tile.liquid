{% doc %}
  The Millinery — one collection tile.

  @param {object} c - The collection
  @param {object} [image] - Optional image override
  @param {string} [label] - Optional name override
{% enddoc %}
{%- liquid
  assign pic = image
  if pic == blank
    assign pic = c.featured_image
  endif
  if pic == blank
    assign pic = c.products.first.featured_media.preview_image
  endif
-%}
<a class="mil-ctile" href="{{ c.url }}">
  <span class="mil-ctile__media mil-linen">
    {%- if pic -%}
      {{ pic | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 30vw, 50vw', loading: 'lazy', alt: c.title }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'mil-ctile__ph' }}
    {%- endif -%}
  </span>
  <span class="mil-ctile__meta">
    <span class="mil-ctile__name">{{ label | default: c.title }}</span>
    <span class="mil-ctile__go mil-meta">
      {%- if c.products_count > 0 -%}{{ c.products_count }} {% if c.products_count == 1 %}piece{% else %}pieces{% endif %}{%- else -%}Shop{%- endif %} &rarr;
    </span>
  </span>
</a>
