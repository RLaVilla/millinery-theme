{% doc %}
  The Millinery — global type, linen texture and shared "hatbox label" styles.
  Rendered in layout/theme.liquid after Horizon's own variables so these win.
{% enddoc %}
<link rel="preload" href="{{ 'mil-serif-500.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: 'Mil Serif';
    src: url('{{ 'mil-serif-500.woff2' | asset_url }}') format('woff2');
    font-weight: 400 500; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'Mil Serif';
    src: url('{{ 'mil-serif-500i.woff2' | asset_url }}') format('woff2');
    font-weight: 400 500; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: 'Mil Serif';
    src: url('{{ 'mil-serif-600.woff2' | asset_url }}') format('woff2');
    font-weight: 600 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'Mil Mono';
    src: url('{{ 'mil-courier-prime-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'Mil Mono';
    src: url('{{ 'mil-courier-prime-700.woff2' | asset_url }}') format('woff2');
    font-weight: 700; font-style: normal; font-display: swap;
  }

  :root {
    --mil-serif: 'Mil Serif', 'Cormorant Garamond', Garamond, 'Times New Roman', serif;
    --mil-mono: 'Mil Mono', 'Courier New', Courier, monospace;
    --mil-ink: {{ settings.color_palette.foreground }};
    --mil-paper: {{ settings.color_palette.background }};
    --mil-accent: {{ settings.color_palette.color1 }};
    --mil-tile: {{ settings.color_palette.color2 }};
    --mil-rule: {{ settings.color_palette.color3 }};
    --mil-faint: color-mix(in srgb, var(--mil-ink) 55%, transparent);
    --mil-gutter: clamp(18px, 3.5vw, 56px);
    --mil-body: 17px;
    --mil-small: 11px;

    --font-body--family: var(--mil-serif);
    --font-subheading--family: var(--mil-serif);
    --font-heading--family: var(--mil-serif);
    --font-accent--family: var(--mil-mono);
  }

  /* Woven linen — pure CSS, no image to load */
  .mil-linen {
    background-color: var(--mil-tile);
    background-image:
      repeating-linear-gradient(0deg, rgba(60, 45, 30, 0.035) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(60, 45, 30, 0.03) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.35), transparent 60%);
  }
  /* Product shots on white sit into the linen */
  .mil-linen img { mix-blend-mode: multiply; }

  body {
    font-family: var(--mil-serif);
    font-size: var(--mil-body);
    color: var(--mil-ink);
    background: var(--mil-paper);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: var(--mil-serif);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Shared pieces */
  .mil-section { font: 400 var(--mil-body) / 1.5 var(--mil-serif); }
  .mil-wrap { padding-inline: var(--mil-gutter); }
  .mil-meta {
    font: 400 var(--mil-small) / 1.5 var(--mil-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .mil-stamp {
    font-family: var(--mil-serif);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  /* Section heading: italic serif with a hairline running out to the edge */
  .mil-heading {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 0 0 32px;
    font: italic 500 clamp(26px, 3vw, 38px) / 1.1 var(--mil-serif);
  }
  .mil-heading::after { content: ''; flex: 1; border-top: 1px solid var(--mil-rule); transform: translateY(-0.3em); }
  .mil-heading small { font: 400 var(--mil-small) var(--mil-mono); font-style: normal; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mil-faint); }

  /* Hang tag: rounded tag with a punched hole */
  .mil-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px 5px 9px;
    border: 1px solid currentColor;
    border-radius: 3px 14px 14px 3px;
    font: 400 var(--mil-small) / 1 var(--mil-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  /* Punched hole: sits in the flex row so it centers with the text */
  .mil-tag::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border: 1px solid currentColor;
    border-radius: 50%;
    transform: translateY(-0.5px);
  }

  .mil-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .mil-link:hover { color: var(--mil-accent); }

  .mil-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 15px 30px;
    background: var(--mil-ink); color: var(--mil-paper);
    border: 1px solid var(--mil-ink); border-radius: 0;
    font: 400 var(--mil-small) var(--mil-mono);
    text-transform: uppercase; letter-spacing: 0.12em;
    text-decoration: none; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .mil-btn:hover { background: var(--mil-accent); border-color: var(--mil-accent); }
  .mil-btn--ghost { background: transparent; color: var(--mil-ink); }
  .mil-btn--ghost:hover { background: var(--mil-ink); color: var(--mil-paper); border-color: var(--mil-ink); }

  /* Horizon buttons pick up the same look */
  .button, button.button, .shopify-payment-button__button--unbranded {
    border-radius: 0 !important;
    font-family: var(--mil-mono) !important;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
</style>
