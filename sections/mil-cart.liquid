{% doc %}
  The Millinery — cart page ("Your bag"). Plain form-based cart: line items on
  linen, quantity update, remove, order note, subtotal and checkout. No JS needed.
{% enddoc %}
<div class="mil-cart mil-section mil-wrap">
  <h1 class="mil-heading">
    Your bag
    {%- if cart.item_count > 0 -%}<small>{{ cart.item_count }} {% if cart.item_count == 1 %}piece{% else %}pieces{% endif %}</small>{%- endif -%}
  </h1>

  {%- if cart.item_count == 0 -%}
    <div class="mil-cart__empty">
      <p class="mil-cart__empty-title">Nothing in your bag yet.</p>
      <div class="mil-cart__empty-ctas">
        <a class="mil-btn" href="{{ routes.all_products_collection_url }}">Shop hats</a>
        <a class="mil-btn mil-btn--ghost" href="{{ section.settings.fitting_link | default: '/pages/book-a-fitting' }}">Reserve a fitting</a>
      </div>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="mil-cart__layout" novalidate>
      <ul class="mil-cart__lines" role="list">
        {%- for item in cart.items -%}
          <li class="mil-cart__line">
            <a href="{{ item.url }}" class="mil-cart__img mil-linen">
              {%- if item.image -%}
                {{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.product.title }}
              {%- endif -%}
            </a>
            <div class="mil-cart__body">
              <a href="{{ item.url }}" class="mil-cart__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="mil-meta mil-cart__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- for p in item.properties -%}
                {%- assign first_char = p.first | slice: 0 -%}
                {%- unless p.last == blank or first_char == '_' -%}
                  <p class="mil-meta mil-cart__variant">{{ p.first }}: {{ p.last }}</p>
                {%- endunless -%}
              {%- endfor -%}
              <div class="mil-cart__row">
                <label class="mil-cart__qty">
                  <span class="mil-meta">Qty</span>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}">
                </label>
                <a class="mil-meta mil-cart__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
            </div>
            <p class="mil-meta mil-cart__price">
              {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s><br>{%- endif -%}
              {{ item.final_line_price | money }}
            </p>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="mil-cart__summary">
        <p class="mil-stamp mil-cart__summary-title">Summary</p>
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="mil-cart__sum-row"><span>{{ discount.title }}</span><span class="mil-meta">-{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="mil-cart__sum-row mil-cart__total"><span>Subtotal</span><span class="mil-meta">{{ cart.total_price | money_with_currency }}</span></div>
        <p class="mil-cart__fine">Shipping and taxes are worked out at checkout.</p>
        {%- if section.settings.show_note -%}
          <label class="mil-cart__note">
            <span class="mil-meta">Note for the shop (optional)</span>
            <textarea name="note" rows="3" placeholder="A gift message, a date you need it by…">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}
        <button type="submit" name="checkout" class="mil-btn mil-cart__checkout">Checkout</button>
        <button type="submit" name="update" class="mil-btn mil-btn--ghost mil-cart__update">Update bag</button>
        {%- if additional_checkout_buttons and section.settings.show_express -%}
          <div class="mil-cart__express">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <a class="mil-link mil-cart__continue" href="{{ routes.all_products_collection_url }}">Keep shopping</a>
      </aside>
    </form>
  {%- endif -%}
</div>

<style>
  .mil-cart { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-cart__layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .mil-cart__lines { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--mil-rule); }
  .mil-cart__line {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--mil-rule);
  }
  .mil-cart__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; }
  .mil-cart__img img { width: 100%; height: 100%; object-fit: contain; padding: 8%; }
  .mil-cart__title { color: inherit; text-decoration: none; font: 500 22px / 1.2 var(--mil-serif); }
  .mil-cart__title:hover { color: var(--mil-accent); }
  .mil-cart__variant { margin: 4px 0 0; color: var(--mil-faint); }
  .mil-cart__row { display: flex; align-items: center; gap: 20px; margin-top: 14px; }
  .mil-cart__qty { display: inline-flex; align-items: center; gap: 8px; }
  .mil-cart__qty input { width: 64px; padding: 8px 10px; border: 1px solid var(--mil-rule); background: #fff; font: 400 16px var(--mil-serif); }
  .mil-cart__remove { color: var(--mil-faint); }
  .mil-cart__remove:hover { color: var(--mil-accent); }
  .mil-cart__price { margin: 0; text-align: right; white-space: nowrap; }
  .mil-cart__price s { color: var(--mil-faint); }

  .mil-cart__summary { position: sticky; top: 90px; padding: 22px 24px; border: 3px double var(--mil-ink); }
  .mil-cart__summary-title { margin: 0 0 14px; font-size: 13px; text-align: center; }
  .mil-cart__sum-row { display: flex; justify-content: space-between; padding: 6px 0; }
  .mil-cart__total { border-top: 1px solid var(--mil-rule); padding-top: 12px; font-size: 19px; }
  .mil-cart__fine { margin: 4px 0 16px; color: var(--mil-faint); font-size: 15px; }
  .mil-cart__note { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .mil-cart__note textarea { padding: 10px 12px; border: 1px solid var(--mil-rule); background: #fff; font: 400 16px / 1.3 var(--mil-serif); }
  .mil-cart__checkout, .mil-cart__update { width: 100%; }
  .mil-cart__update { margin-top: 8px; }
  .mil-cart__express { margin-top: 12px; }
  .mil-cart__continue { display: block; margin-top: 16px; text-align: center; font-size: 16px; }

  .mil-cart__empty { padding: 40px 0 20px; }
  .mil-cart__empty-title { font: italic 500 28px var(--mil-serif); margin: 0 0 20px; }
  .mil-cart__empty-ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 899px) {
    .mil-cart__layout { grid-template-columns: 1fr; }
    .mil-cart__line { grid-template-columns: 84px minmax(0, 1fr); }
    .mil-cart__price { grid-column: 2; text-align: left; }
    .mil-cart__summary { position: static; }
  }
</style>

{% schema %}
{
  "name": "Millinery cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "default": true },
    { "type": "url", "id": "fitting_link", "label": "Fitting page link (empty bag)", "default": "/pages/book-a-fitting" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 120 }
  ]
}
{% endschema %}
