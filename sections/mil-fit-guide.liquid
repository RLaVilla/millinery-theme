{% comment %}
  The Millinery — fit guide. Intro, how-to-measure steps (hang-tag numbers),
  a real size chart (cm, inches auto-calculated, hat size) from blocks, a tip,
  and a fitting prompt. Optionally shows the page's own content below.
{% endcomment %}
<div class="mil-fg mil-section mil-wrap">
  <header class="mil-fg__head">
    {%- if section.settings.tag != blank -%}<span class="mil-tag mil-fg__tag">{{ section.settings.tag }}</span>{%- endif -%}
    <h1 class="mil-fg__title">{{ section.settings.title | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}<div class="mil-fg__intro">{{ section.settings.intro }}</div>{%- endif -%}
  </header>

  <div class="mil-fg__layout">
    <section class="mil-fg__steps" aria-labelledby="FgSteps-{{ section.id }}">
      <h2 class="mil-heading" id="FgSteps-{{ section.id }}">{{ section.settings.steps_heading }}</h2>
      {%- if section.settings.image != blank -%}
        <div class="mil-fg__img mil-linen">
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'lazy', alt: section.settings.steps_heading }}
        </div>
      {%- endif -%}
      <ol class="mil-fg__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign n = forloop.index | prepend: '0' | slice: -2, 2 -%}
            <li {{ block.shopify_attributes }}>
              <span class="mil-tag mil-fg__no">No. {{ n }}</span>
              <span class="mil-fg__step">{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </section>

    <section class="mil-fg__chart" aria-labelledby="FgChart-{{ section.id }}">
      <div class="mil-fg__card">
        <p class="mil-stamp mil-fg__card-title" id="FgChart-{{ section.id }}">{{ section.settings.chart_heading }}</p>
        <table class="mil-fg__table">
          <thead>
            <tr><th scope="col">Head (cm)</th><th scope="col">Head (in)</th><th scope="col">Hat size</th></tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'size' -%}
                {%- liquid
                  assign cm = block.settings.cm | plus: 0.0
                  assign inches = cm | divided_by: 2.54 | round: 1
                -%}
                <tr {{ block.shopify_attributes }}>
                  <td>{{ block.settings.cm }}</td>
                  <td>{{ inches }}</td>
                  <td class="mil-fg__size">{{ block.settings.size }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
        {%- if section.settings.tip != blank -%}
          <p class="mil-fg__tip"><span class="mil-meta">Tip</span> {{ section.settings.tip }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_title != blank -%}
        <div class="mil-fg__cta">
          <p class="mil-fg__cta-title">{{ section.settings.cta_title }}</p>
          <p class="mil-fg__cta-text">{{ section.settings.cta_text }}</p>
          <div class="mil-fg__cta-btns">
            <a class="mil-btn" href="{{ section.settings.cta_link | default: '/pages/book-a-fitting' }}">{{ section.settings.cta_label }}</a>
            <a class="mil-btn mil-btn--ghost" href="{{ routes.all_products_collection_url }}">Shop hats</a>
          </div>
        </div>
      {%- endif -%}
    </section>
  </div>

  {%- if section.settings.show_page_content and page.content != blank -%}
    <div class="mil-fg__extra rte">{{ page.content }}</div>
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }} { --mil-pt: calc({{ section.settings.pad_top }}px * var(--mil-space, 1)); --mil-pb: calc({{ section.settings.pad_bottom }}px * var(--mil-space, 1)); }
  .mil-fg { padding-block: var(--mil-pt) var(--mil-pb); }
  .mil-fg__head { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .mil-fg__tag { color: var(--mil-accent); }
  .mil-fg__title { margin: 16px 0 14px; font: 500 clamp(40px, 5.4vw, 76px) / 1 var(--mil-serif); letter-spacing: -0.01em; }
  .mil-fg__intro { font-size: 19px; line-height: 1.55; color: color-mix(in srgb, var(--mil-ink) 80%, transparent); }
  .mil-fg__intro p { margin: 0; }

  .mil-fg__layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .mil-fg__img { aspect-ratio: 16 / 10; overflow: hidden; margin-bottom: 24px; }
  .mil-fg__img img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; }
  .mil-fg__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--mil-rule); }
  .mil-fg__list li { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--mil-rule); }
  .mil-fg__no { color: var(--mil-accent); justify-self: start; }
  .mil-fg__step { font-size: 18px; line-height: 1.5; }

  .mil-fg__chart { position: sticky; top: 90px; }
  .mil-fg__card { padding: 22px 24px 18px; border: 3px double var(--mil-ink); background: var(--mil-paper); }
  .mil-fg__card-title { margin: 0 0 14px; font-size: 13px; text-align: center; }
  .mil-fg__table { width: 100%; border-collapse: collapse; }
  .mil-fg__table th { padding: 8px 6px; border-bottom: 1px solid var(--mil-ink); text-align: left; font: 400 var(--mil-small) / 1.3 var(--mil-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  .mil-fg__table td { padding: 9px 6px; border-bottom: 1px dotted var(--mil-rule); font: 400 14px / 1.2 var(--mil-mono); }
  .mil-fg__table tr:last-child td { border-bottom: 0; }
  .mil-fg__table tbody tr:hover { background: var(--mil-tile); }
  .mil-fg__size { font: 500 19px / 1 var(--mil-serif) !important; }
  .mil-fg__tip { margin: 14px 0 0; padding: 12px 14px; background: var(--mil-tile); font-size: 16px; line-height: 1.45; }
  .mil-fg__tip .mil-meta { margin-right: 8px; color: var(--mil-accent); }

  .mil-fg__cta { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--mil-rule); }
  .mil-fg__cta-title { margin: 0 0 6px; font: italic 500 26px / 1.15 var(--mil-serif); }
  .mil-fg__cta-text { margin: 0 0 16px; color: var(--mil-faint); font-size: 16px; }
  .mil-fg__cta-btns { display: flex; flex-wrap: wrap; gap: 10px; }

  .mil-fg__extra { max-width: 1100px; margin: 72px auto 0; padding-top: 40px; border-top: 1px solid var(--mil-rule); text-align: center; }
  .mil-fg__extra p { margin: 0 0 12px; }
  .mil-fg__extra img { display: block; width: 100%; max-width: 1100px; height: auto; margin: 0 auto; outline: 1px solid var(--mil-rule); outline-offset: -1px; }

  @media (max-width: 899px) {
    .mil-fg__layout { grid-template-columns: 1fr; }
    .mil-fg__chart { position: static; }
    .mil-fg__list li { grid-template-columns: 1fr; gap: 8px; }
    .mil-fg__step { font-size: 17px; }
    .mil-fg__card { padding: 18px 16px 14px; }
    .mil-fg__cta-btns .mil-btn { flex: 1; }
  }
</style>

{% schema %}
{
  "name": "Millinery fit guide",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Find your fit" },
    { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the page title." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>A good hat should sit snug without pinching. Measure once with a soft tape and use the chart to find your size.</p>" },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "How to measure" },
    { "type": "image_picker", "id": "image", "label": "Steps photo", "info": "Optional." },
    { "type": "text", "id": "chart_heading", "label": "Chart title", "default": "Size chart" },
    { "type": "text", "id": "tip", "label": "Tip", "default": "If you're between sizes, size up for the most comfortable fit." },
    { "type": "text", "id": "cta_title", "label": "Fitting prompt title", "default": "Still not sure?" },
    { "type": "text", "id": "cta_text", "label": "Fitting prompt text", "default": "Come in for a private fitting and we'll measure you properly." },
    { "type": "text", "id": "cta_label", "label": "Fitting button", "default": "Book a fitting" },
    { "type": "url", "id": "cta_link", "label": "Fitting button link", "info": "Leave empty for /pages/book-a-fitting" },
    { "type": "checkbox", "id": "show_page_content", "label": "Also show the page's own content below", "default": false, "info": "Turn on to show the original fit guide image under the chart." },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [{ "type": "textarea", "id": "text", "label": "Step", "default": "Use a soft measuring tape." }]
    },
    {
      "type": "size",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "cm", "label": "Head circumference (cm)", "default": "57.2" },
        { "type": "text", "id": "size", "label": "Hat size", "default": "7 1/8" }
      ]
    }
  ],
  "presets": [{ "name": "Millinery fit guide" }]
}
{% endschema %}
