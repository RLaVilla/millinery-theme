{% doc %}
  The Millinery — visit the shop: map, address, hours, call/text, and FAQ
  (as blocks). Built for the fitting landing page but works anywhere.
{% enddoc %}
{%- liquid
  assign phone_digits = section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
  assign map_q = section.settings.map_query | url_encode
-%}
<div class="mil-visit mil-section mil-wrap">
  {%- if section.settings.heading != blank -%}
    <h2 class="mil-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="mil-visit__layout">
    <div class="mil-visit__map mil-linen">
      {%- if section.settings.show_map and section.settings.map_query != blank -%}
        <iframe
          title="Map to {{ shop.name | escape }}"
          src="https://www.google.com/maps?q={{ map_q }}&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      {%- endif -%}
    </div>

    <div class="mil-visit__info">
      <div class="mil-visit__card">
        <p class="mil-stamp mil-visit__card-title">The shop</p>
        <address>{{ section.settings.address | newline_to_br }}</address>
        {%- if section.settings.hours != blank -%}
          <div class="mil-visit__hours">
            {%- assign lines = section.settings.hours | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- if parts.size > 0 -%}
                <div class="mil-visit__row"><span>{{ parts[0] | strip }}</span><span class="mil-meta">{{ parts[1] | strip }}</span></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="mil-visit__ctas">
          {%- if section.settings.show_directions and section.settings.map_query != blank -%}
            <a class="mil-btn mil-btn--ghost" href="https://www.google.com/maps/dir/?api=1&destination={{ map_q }}" target="_blank" rel="noopener">Directions</a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a class="mil-btn mil-btn--ghost" href="tel:{{ phone_digits }}">Call {{ section.settings.phone }}</a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="mil-visit__faq">
          {%- if section.settings.faq_heading != blank -%}
            <p class="mil-stamp mil-visit__card-title mil-visit__faq-title">{{ section.settings.faq_heading }}</p>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <details class="mil-faq" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="mil-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="mil-btn mil-visit__book" href="{{ section.settings.cta_link | default: '#book-form' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .mil-visit { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-visit__layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .mil-visit__map { aspect-ratio: 4 / 3; overflow: hidden; }
  .mil-visit__map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.6) sepia(0.15) contrast(0.95); }
  .mil-visit__card { padding: 22px 24px; border: 3px double var(--mil-ink); }
  .mil-visit__card-title { margin: 0 0 12px; font-size: 13px; }
  .mil-visit__card address { font-style: normal; font-size: 18px; line-height: 1.45; margin-bottom: 14px; }
  .mil-visit__hours { border-top: 1px solid var(--mil-rule); padding-top: 10px; }
  .mil-visit__row { display: flex; justify-content: space-between; gap: 16px; padding: 3px 0; font-size: 16px; }
  .mil-visit__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .mil-visit__faq { margin-top: 32px; }
  .mil-faq { border-top: 1px solid var(--mil-rule); }
  .mil-faq:last-child { border-bottom: 1px solid var(--mil-rule); }
  .mil-faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    font: 500 19px / 1.25 var(--mil-serif);
  }
  .mil-faq summary::-webkit-details-marker { display: none; }
  .mil-faq summary::after { content: '+'; font: 400 18px var(--mil-mono); color: var(--mil-accent); }
  .mil-faq[open] summary::after { content: '\2013'; }
  .mil-faq__a { padding: 0 0 16px; color: color-mix(in srgb, var(--mil-ink) 80%, transparent); font-size: 17px; }
  .mil-faq__a p { margin: 0 0 8px; }
  .mil-visit__book { width: 100%; margin-top: 28px; }

  @media (max-width: 899px) {
    .mil-visit__layout { grid-template-columns: 1fr; }
    .mil-visit__ctas .mil-btn { flex: 1; }
  }
</style>

{% schema %}
{
  "name": "Millinery visit & FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit the shop" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "The Millinery\n123 Main St\nKeansburg, NJ 07734" },
    { "type": "text", "id": "map_query", "label": "Map location", "default": "Keansburg, NJ", "info": "Town only keeps the exact studio address private." },
    { "type": "checkbox", "id": "show_map", "label": "Show map", "default": true },
    { "type": "checkbox", "id": "show_directions", "label": "Show Directions button", "default": false },
    { "type": "textarea", "id": "hours", "label": "Hours", "info": "One line per row, label | time. e.g. Wed – Fri | 11am – 6pm", "default": "Wed – Fri | 11am – 6pm\nSaturday | 10am – 6pm\nSunday | 12 – 5pm\nMon – Tue | By appointment" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(732) 757-7567" },
    { "type": "text", "id": "faq_heading", "label": "FAQ title", "default": "Good to know" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Request my fitting" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to jump to the booking form on this page." },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is there a charge for a fitting?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Millinery visit & FAQ" }]
}
{% endschema %}
