{% comment %}
  The Millinery — featured collection banner. One big image with a double-ruled
  caption card: season label, collection name, a line of text, Shop now.
  Swap the collection (and image / label) each season in the theme editor.
{% endcomment %}
{%- liquid
  assign c = section.settings.collection
  assign pic = section.settings.image
  if pic == blank and c != blank
    assign pic = c.featured_image
  endif
  if pic == blank and c != blank
    assign pic = c.products.first.featured_media.preview_image
  endif
  assign title = section.settings.title
  if title == blank and c != blank
    assign title = c.title
  endif
  assign link = routes.all_products_collection_url
  if c != blank
    assign link = c.url
  endif
-%}
{%- if c != blank or request.design_mode -%}
  <div class="mil-fc mil-section mil-wrap mil-fc--{{ section.settings.align }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mil-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <a class="mil-fc__frame mil-linen" href="{{ link }}">
      {%- if pic -%}
        {{
          pic
          | image_url: width: 2400
          | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: title,
            class: 'mil-fc__img'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'mil-fc__img mil-fc__ph' }}
      {%- endif -%}
      <span class="mil-fc__card">
        {%- if section.settings.kicker != blank -%}
          <span class="mil-tag mil-fc__tag">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <span class="mil-fc__title">{{ title | default: 'Pick a collection' }}</span>
        {%- if section.settings.text != blank -%}
          <span class="mil-fc__text">{{ section.settings.text }}</span>
        {%- endif -%}
        <span class="mil-btn mil-fc__btn">{{ section.settings.button }}</span>
      </span>
    </a>
  </div>
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} { --mil-pt: calc({{ section.settings.pad_top }}px * var(--mil-space, 1)); --mil-pb: calc({{ section.settings.pad_bottom }}px * var(--mil-space, 1)); }
  .mil-fc { padding-block: var(--mil-pt) var(--mil-pb); }
  .mil-fc__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 8;
    max-height: 84vh;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  .mil-fc__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; transition: transform 1.2s ease; }
  .mil-fc__ph { fill: var(--mil-faint); opacity: 0.25; }
  .mil-fc__frame:hover .mil-fc__img { transform: scale(1.025); }
  .mil-fc__card {
    position: absolute;
    bottom: clamp(16px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: min(440px, calc(100% - 32px));
    padding: 22px 26px 24px;
    background: color-mix(in srgb, var(--mil-paper) 95%, transparent);
    border: 3px double var(--mil-ink);
  }
  .mil-fc--left .mil-fc__card { left: clamp(16px, 3vw, 40px); }
  .mil-fc--right .mil-fc__card { right: clamp(16px, 3vw, 40px); }
  .mil-fc__tag { color: var(--mil-accent); }
  .mil-fc__title { font: 500 clamp(32px, 4vw, 56px) / 1 var(--mil-serif); letter-spacing: -0.01em; }
  .mil-fc__text { font-size: 17px; line-height: 1.5; color: color-mix(in srgb, var(--mil-ink) 80%, transparent); }
  .mil-fc__btn { margin-top: 6px; }
  .mil-fc__frame:hover .mil-fc__btn { background: var(--mil-accent); border-color: var(--mil-accent); }

  @media (max-width: 899px) {
    .mil-fc__frame { aspect-ratio: auto; max-height: none; display: flex; flex-direction: column; margin-inline: calc(var(--mil-gutter) * -1); }
    .mil-fc__img { position: relative; aspect-ratio: 4 / 4.6; height: auto; }
    .mil-fc__card {
      position: relative;
      left: auto !important;
      right: auto !important;
      bottom: auto;
      max-width: none;
      margin: -44px var(--mil-gutter) 0;
      padding: 18px 18px 20px;
    }
    .mil-fc__btn { align-self: stretch; }
  }
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "info": "Optional heading above the banner." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
    { "type": "text", "id": "kicker", "label": "Season label", "default": "Fall / Winter" },
    { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection name." },
    { "type": "text", "id": "text", "label": "Text", "default": "Warm felts and deeper colors for the colder months." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
    {
      "type": "select",
      "id": "align",
      "label": "Card position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
