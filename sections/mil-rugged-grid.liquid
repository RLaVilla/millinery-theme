{% comment %}
  Chopper Corner — dark product grid. Shows any collection she picks
  (leather, belts, apparel… whatever lives in Chopper Corner).
{% endcomment %}
{%- liquid
  assign source = section.settings.collection
  if template.name == 'collection' and collection != blank
    assign source = collection
  endif
  assign cols = section.settings.columns
-%}
<div class="mil-rgg mil-rg" id="chopper-gear">
  <div class="mil-wrap mil-rgg__inner">
    <div class="mil-rgg__head">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="mil-rg__kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="mil-rgg__title mil-rg__display">{{ section.settings.heading }}</h2>
      </div>
      {%- if source != blank and source.products_count > section.settings.limit and template.name != 'collection' -%}
        <a class="mil-rgg__all" href="{{ source.url }}">View all {{ source.products_count }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if source != blank and source.products_count > 0 -%}
      <ul class="mil-rgg__list" role="list" style="--rg-cols: {{ cols }};">
        {%- for product in source.products limit: section.settings.limit -%}
          {%- assign img = product.featured_media.preview_image -%}
          <li>
            <a class="mil-rgg__card" href="{{ product.url }}">
              <span class="mil-rgg__media">
                <span class="mil-rgg__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- if img -%}
                  {{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: product.title }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'mil-rgg__ph' }}
                {%- endif -%}
              </span>
              <span class="mil-rgg__meta">
                <span class="mil-rgg__name mil-rg__display">{{ product.title }}</span>
                <span class="mil-rgg__price">{% if product.available %}{{ product.price | money }}{% else %}Sold out{% endif %}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="mil-rgg__empty">
        <p class="mil-rg__display mil-rgg__empty-title">{{ section.settings.empty_title }}</p>
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} { --mil-pt: calc({{ section.settings.pad_top }}px * var(--mil-space, 1)); --mil-pb: calc({{ section.settings.pad_bottom }}px * var(--mil-space, 1)); }
  .mil-rgg__inner { padding-block: var(--mil-pt) var(--mil-pb); }
  .mil-rgg__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 32px; padding-bottom: 18px; border-bottom: 1px solid var(--rg-line); }
  .mil-rgg__title { margin: 12px 0 0; font-size: clamp(44px, 6vw, 84px); }
  .mil-rgg__all { color: var(--rg-brass); font: 400 var(--mil-small) var(--mil-mono); text-transform: uppercase; letter-spacing: 0.14em; text-decoration: none; white-space: nowrap; }
  .mil-rgg__all:hover { color: var(--rg-ink); }
  .mil-rgg__list { display: grid; grid-template-columns: repeat(var(--rg-cols), minmax(0, 1fr)); gap: 40px clamp(12px, 1.6vw, 22px); margin: 0; padding: 0; list-style: none; }
  .mil-rgg__card { display: block; color: inherit; text-decoration: none; }
  .mil-rgg__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 35%, #2a2826 0%, var(--rg-steel) 70%);
    outline: 1px solid var(--rg-line);
    outline-offset: -1px;
    transition: outline-color 0.2s;
  }
  .mil-rgg__card:hover .mil-rgg__media { outline-color: var(--rg-brass); }
  .mil-rgg__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 8%; transition: transform 0.8s ease; }
  .mil-rgg__card:hover .mil-rgg__media img { transform: scale(1.04); }
  .mil-rgg__ph { position: absolute; inset: 0; width: 100%; height: 100%; fill: rgba(236, 229, 216, 0.18); }
  .mil-rgg__no { position: absolute; top: 10px; left: 12px; z-index: 1; font: 400 18px / 1 var(--rg-display); color: var(--rg-brass); letter-spacing: 0.08em; }
  .mil-rgg__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 14px; }
  .mil-rgg__name { font-size: 26px; line-height: 1; }
  .mil-rgg__price { font: 400 12px var(--mil-mono); letter-spacing: 0.06em; color: var(--rg-dim); white-space: nowrap; }
  .mil-rgg__card:hover .mil-rgg__name { color: var(--rg-brass); }
  .mil-rgg__empty { padding: 60px 0 20px; color: var(--rg-dim); max-width: 46ch; }
  .mil-rgg__empty-title { font-size: 42px; color: var(--rg-ink); margin: 0 0 10px; }
  @media (max-width: 899px) {
    .mil-rgg__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 10px; }
    .mil-rgg__meta { flex-direction: column; gap: 4px; }
    .mil-rgg__name { font-size: 21px; }
    .mil-rgg__head { flex-direction: column; align-items: flex-start; }
  }
</style>

{% schema %}
{
  "name": "Rugged product grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop the corner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gear" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "On a collection page this uses that collection automatically." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 50, "step": 1, "default": 8 },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Gear's on the way" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "New pieces are being made in the shop. Check back soon." },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Rugged product grid" }]
}
{% endschema %}
