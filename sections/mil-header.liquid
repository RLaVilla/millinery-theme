{% comment %}
  The Millinery — "hatbox label" header.
  Top strip with live open/closed status from the shop hours, a stamped label
  wordmark in the center, and a banded nav row (thin rules above and below)
  that sticks on scroll.
{% endcomment %}
{%- liquid
  assign menu = section.settings.menu
  capture hours_json
    echo '['
    for d in (0..6)
      assign key = 'hours_' | append: d
      echo '"' | append: section.settings[key] | append: '"'
      unless forloop.last
        echo ','
      endunless
    endfor
    echo ']'
  endcapture
-%}
<header class="mil-header mil-wrap" data-mil-header>
  <div class="mil-header__strip mil-meta">
    <span data-mil-status data-tz="{{ section.settings.timezone }}" data-hours='{{ hours_json | strip }}'>
      {{- section.settings.city -}}
    </span>
    <span class="mil-header__note">{{ section.settings.note }}</span>
    {%- if section.settings.phone != blank -%}
      <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' }}">
        {{- section.settings.phone -}}
      </a>
    {%- else -%}
      <span></span>
    {%- endif -%}
  </div>

  <a href="{{ routes.root_url }}" class="mil-header__logo" aria-label="{{ shop.name }}">
    {%- if section.settings.logo != blank -%}
      <span class="mil-header__logo-img" style="--mil-logo-h: {{ section.settings.logo_height }}px;">
        {{- section.settings.logo | image_url: width: 800 | image_tag: alt: shop.name -}}
      </span>
    {%- elsif section.settings.brand_logo != 'none' -%}
      {%- assign logo_file = 'mil-logo-' | append: section.settings.brand_logo | append: '.png' -%}
      <span class="mil-header__logo-img" style="--mil-logo-h: {{ section.settings.logo_height }}px;">
        <img src="{{ logo_file | asset_url }}" alt="{{ shop.name | escape }}" width="860" height="624" fetchpriority="high">
      </span>
    {%- else -%}
      <span class="mil-label-mark">
        <span class="mil-label-mark__name mil-stamp">{{ section.settings.wordmark | default: shop.name }}</span>
        <span class="mil-label-mark__sub mil-meta">{{ section.settings.sub_mark }}</span>
      </span>
    {%- endif -%}
  </a>

  <div class="mil-header__band-slot">
    <nav class="mil-header__band" data-mil-band aria-label="Primary">
      <button
        type="button"
        class="mil-header__toggle mil-meta"
        aria-expanded="false"
        aria-controls="MilMenu-{{ section.id }}"
        data-mil-toggle
      >
        <span class="mil-header__burger" aria-hidden="true"></span>
        <span data-mil-toggle-label>Menu</span>
      </button>

      {%- if section.settings.book_label != blank -%}
        <a class="mil-header__book mil-meta" href="{{ section.settings.book_link | default: '/products/private-hat-fitting' }}">
          {{- section.settings.book_label -}}
        </a>
      {%- endif -%}

      <ul class="mil-header__menu" role="list">
        {%- for link in menu.links -%}
          <li class="mil-header__item{% if link.links.size > 0 %} has-children{% endif %}">
            <a
              href="{{ link.url }}"
              class="mil-header__navlink{% if link.active or link.child_active %} is-active{% endif %}"
              {% if link.active %}
                aria-current="page"
              {% endif %}
              {% if link.links.size > 0 %}
                aria-haspopup="true"
              {% endif %}
            >
              {{- link.title -}}
            </a>
            {%- if link.links.size > 0 -%}
              <ul class="mil-header__drop" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="{% if child.active %}is-active{% endif %}">{{ child.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- else -%}
          <li class="mil-header__item"><a class="mil-header__navlink" href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li class="mil-header__item"><a class="mil-header__navlink" href="/products/private-hat-fitting">Custom</a></li>
        {%- endfor -%}
      </ul>

      <div class="mil-header__utils mil-meta">
        <a href="{{ routes.search_url }}" class="mil-header__search">Search</a>
        <a href="{{ routes.cart_url }}">Bag (<span data-mil-cart-count>{{ cart.item_count }}</span>)</a>
      </div>
    </nav>
  </div>

  <div class="mil-header__panel" id="MilMenu-{{ section.id }}" data-mil-panel hidden>
    <ul class="mil-header__panel-list" role="list">
      {%- for link in menu.links -%}
        <li>
          <a href="{{ link.url }}" class="mil-header__panel-link{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <ul class="mil-header__panel-sub" role="list">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}">{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- else -%}
        <li><a class="mil-header__panel-link" href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a class="mil-header__panel-link" href="/products/private-hat-fitting">Custom</a></li>
      {%- endfor -%}
      <li><a class="mil-header__panel-link" href="{{ routes.search_url }}">Search</a></li>
    </ul>
    {%- if section.settings.book_label != blank -%}
      <a class="mil-btn mil-header__panel-book" href="{{ section.settings.book_link | default: '/products/private-hat-fitting' }}">
        {{- section.settings.book_label -}}
      </a>
    {%- endif -%}
    {%- if section.settings.phone != blank -%}
      <p class="mil-meta mil-header__panel-phone">
        <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.phone }}</a>
        · {{ section.settings.city }}
      </p>
    {%- endif -%}
  </div>
</header>

<style>
  .mil-header { background: var(--mil-paper); color: var(--mil-ink); }
  .mil-header__strip {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    padding-block: 12px;
    color: var(--mil-faint);
  }
  .mil-header__strip > :last-child { justify-self: end; }
  .mil-header__strip a { color: inherit; text-decoration: none; }
  [data-mil-status].is-open::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: #5f7f5a;
    vertical-align: 1px;
  }

  .mil-header__logo {
    display: flex;
    justify-content: center;
    padding-block: 28px 32px;
    color: var(--mil-ink);
    text-decoration: none;
  }
  .mil-header__logo-img img { display: block; height: var(--mil-logo-h); width: auto; }

  /* Wordmark set like the stamp inside a sweatband */
  .mil-label-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 34px 12px;
    border: 3px double currentColor;
    border-radius: 999px;
  }
  .mil-label-mark__name { font-size: clamp(20px, 2.6vw, 30px); line-height: 1; padding-left: 0.22em; }
  .mil-label-mark__sub { font-size: 10px; letter-spacing: 0.24em; color: var(--mil-faint); }

  .mil-header__band-slot { min-height: var(--mil-band-h, 50px); }
  .mil-header__band {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 13px;
    border-top: 1px solid var(--mil-ink);
    border-bottom: 1px solid var(--mil-ink);
    background: var(--mil-paper);
  }
  .mil-header__band.is-stuck {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: var(--mil-gutter);
    border-top-color: transparent;
    box-shadow: 0 1px 0 var(--mil-ink);
  }
  .mil-header__menu {
    grid-column: 2;
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-header__item { position: relative; }
  .mil-header__navlink {
    font: 500 15px / 1 var(--mil-serif);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }
  .mil-header__navlink:hover { color: var(--mil-accent); }
  .mil-header__navlink.is-active { border-bottom-color: currentColor; }
  .has-children > .mil-header__navlink::after { content: ' \25BE'; font-size: 10px; letter-spacing: 0; }

  .mil-header__drop {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    min-width: 200px;
    margin: 0;
    padding: 12px 18px;
    list-style: none;
    background: var(--mil-paper);
    border: 3px double var(--mil-ink);
    transform: translate(-50%, 4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
    z-index: 60;
  }
  .mil-header__drop::before { content: ''; position: absolute; inset: -18px 0 auto; height: 18px; }
  .has-children:hover > .mil-header__drop,
  .has-children:focus-within > .mil-header__drop { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .mil-header__drop a { display: block; padding: 6px 0; color: inherit; text-decoration: none; font-size: 17px; white-space: nowrap; }
  .mil-header__drop a:hover,
  .mil-header__drop a.is-active { color: var(--mil-accent); }

  .mil-header__book {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    padding: 7px 14px;
    border: 1px solid var(--mil-accent);
    color: var(--mil-accent);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .mil-header__book:hover { background: var(--mil-accent); color: var(--mil-paper); }
  .mil-header__utils { grid-column: 3; grid-row: 1; justify-self: end; display: flex; gap: 20px; }
  .mil-header__utils a { color: inherit; text-decoration: none; }
  .mil-header__utils a:hover { color: var(--mil-accent); }

  .mil-header__toggle {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .mil-header__burger,
  .mil-header__burger::before,
  .mil-header__burger::after {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
    transition: transform 0.2s, opacity 0.2s;
  }
  .mil-header__burger { position: relative; }
  .mil-header__burger::before,
  .mil-header__burger::after { content: ''; position: absolute; left: 0; }
  .mil-header__burger::before { top: -5px; }
  .mil-header__burger::after { top: 5px; }
  [aria-expanded='true'] .mil-header__burger { background: transparent; }
  [aria-expanded='true'] .mil-header__burger::before { transform: translateY(5px) rotate(45deg); }
  [aria-expanded='true'] .mil-header__burger::after { transform: translateY(-5px) rotate(-45deg); }

  .mil-header__panel {
    position: fixed;
    inset: var(--mil-panel-top, 120px) 0 0;
    z-index: 55;
    overflow-y: auto;
    padding: 28px var(--mil-gutter) 40px;
    background: var(--mil-paper);
  }
  .mil-header__panel[hidden] { display: none; }
  .mil-header__panel-list { margin: 0; padding: 0; list-style: none; }
  .mil-header__panel-list > li { border-bottom: 1px solid var(--mil-rule); }
  .mil-header__panel-link { display: block; padding: 14px 0; color: inherit; text-decoration: none; font: 500 30px / 1.1 var(--mil-serif); }
  .mil-header__panel-link.is-active { color: var(--mil-accent); }
  .mil-header__panel-sub { margin: -6px 0 12px; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .mil-header__panel-sub a { color: var(--mil-faint); text-decoration: none; font-size: 17px; }
  .mil-header__panel-book { width: 100%; margin-top: 28px; }
  .mil-header__panel-phone { margin-top: 16px; text-align: center; color: var(--mil-faint); }
  .mil-header__panel-phone a { color: inherit; }
  body.mil-menu-open { overflow: hidden; }

  @media (min-width: 900px) {
    .mil-header__panel { display: none !important; }
  }

  @media (max-width: 899px) {
    .mil-header__strip { grid-template-columns: 1fr auto; }
    .mil-header__note { display: none; }
    .mil-header__logo { padding-block: 18px 22px; }
    .mil-header__band { grid-template-columns: auto 1fr auto; gap: 12px; }
    .mil-header__toggle { display: inline-flex; grid-column: 1; grid-row: 1; }
    .mil-header__menu { display: none; }
    .mil-header__book { grid-column: 2; justify-self: center; padding: 6px 10px; }
    .mil-header__search { display: none; }
    .mil-header__utils { grid-column: 3; }
  }
</style>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root?.matches('[data-mil-header]') || root.dataset.milReady) return;
    root.dataset.milReady = '1';

    // Live open/closed line from the hours set in the editor (index 0 = Sunday)
    const status = root.querySelector('[data-mil-status]');
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const parse = (s) => {
      const m = String(s || '').replace(/\s/g, '').match(/^(\d{1,2})(?::(\d{2}))?-(\d{1,2})(?::(\d{2}))?$/);
      return m ? [+m[1] * 60 + +(m[2] || 0), +m[3] * 60 + +(m[4] || 0)] : null;
    };
    const fmt = (mins) => {
      const h = Math.floor(mins / 60), m = mins % 60;
      return `${h % 12 || 12}${m ? ':' + String(m).padStart(2, '0') : ''}${h < 12 ? 'AM' : 'PM'}`;
    };
    const update = () => {
      let hours;
      try { hours = JSON.parse(status.dataset.hours).map(parse); } catch { return; }
      if (!hours.some(Boolean)) return;
      const parts = Object.fromEntries(
        new Intl.DateTimeFormat('en-US', {
          timeZone: status.dataset.tz, weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23',
        }).formatToParts(new Date()).map((p) => [p.type, p.value])
      );
      const day = days.indexOf(parts.weekday);
      const now = +parts.hour * 60 + +parts.minute;
      const city = status.dataset.city || '';
      const today = hours[day];
      status.classList.remove('is-open');
      if (today && now >= today[0] && now < today[1]) {
        status.classList.add('is-open');
        status.textContent = `Open today until ${fmt(today[1])} · ${city}`;
        return;
      }
      if (today && now < today[0]) {
        status.textContent = `Opens today at ${fmt(today[0])} · ${city}`;
        return;
      }
      for (let i = 1; i <= 7; i++) {
        const d = (day + i) % 7;
        if (hours[d]) {
          status.textContent = `Closed · Opens ${i === 1 ? 'tomorrow' : days[d]} ${fmt(hours[d][0])} · ${city}`;
          return;
        }
      }
    };
    if (status) {
      status.dataset.city = status.textContent.trim();
      update();
      setInterval(update, 60000);
    }

    // Banded nav sticks to the top once it reaches it
    const band = root.querySelector('[data-mil-band]');
    const slot = band?.parentElement;
    if (band && slot) {
      slot.style.setProperty('--mil-band-h', `${band.offsetHeight}px`);
      new IntersectionObserver(([e]) => {
        band.classList.toggle('is-stuck', !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(slot);
    }

    // Mobile menu panel
    const toggle = root.querySelector('[data-mil-toggle]');
    const panel = root.querySelector('[data-mil-panel]');
    const setMenu = (open) => {
      if (!toggle || !panel) return;
      if (open) {
        const bandEl = root.querySelector('[data-mil-band]');
        root.style.setProperty('--mil-panel-top', `${Math.max(0, bandEl.getBoundingClientRect().bottom)}px`);
      }
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('[data-mil-toggle-label]').textContent = open ? 'Close' : 'Menu';
      document.body.classList.toggle('mil-menu-open', open);
    };
    toggle?.addEventListener('click', () => setMenu(panel.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel && !panel.hidden) { setMenu(false); toggle.focus(); } });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

    // Keep BAG (n) in sync after any add/change, whatever triggered it
    const count = root.querySelector('[data-mil-cart-count]');
    const refresh = () =>
      fetch(`${window.Shopify?.routes?.root || '/'}cart.js`)
        .then((r) => r.json())
        .then((c) => { if (count) count.textContent = c.item_count; })
        .catch(() => {});
    if ('PerformanceObserver' in window) {
      new PerformanceObserver((list) => {
        if (list.getEntries().some((e) => /\/cart\/(add|change|update|clear)/.test(e.name))) refresh();
      }).observe({ type: 'resource', buffered: false });
    }
    window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
  })();
</script>

{% schema %}
{
  "name": "Millinery header",
  "class": "mil-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Custom logo image", "info": "Optional. Overrides the built-in logo below." },
    {
      "type": "select",
      "id": "brand_logo",
      "label": "Built-in logo",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "The Millinery seal — gold" },
        { "value": "ink", "label": "The Millinery seal — ink" },
        { "value": "none", "label": "None (stamped text wordmark)" }
      ]
    },
    { "type": "range", "id": "logo_height", "label": "Logo image height", "min": 30, "max": 140, "step": 2, "unit": "px", "default": 72 },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "The Millinery" },
    { "type": "text", "id": "sub_mark", "label": "Line under wordmark", "default": "Hat Co. · Keansburg, NJ" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Items with nested links get a dropdown." },
    { "type": "text", "id": "book_label", "label": "Booking button", "default": "Book a fitting" },
    { "type": "url", "id": "book_link", "label": "Booking button link", "info": "Leave empty to use /products/private-hat-fitting" },
    { "type": "header", "content": "Top strip" },
    { "type": "text", "id": "city", "label": "Location", "default": "Keansburg, NJ" },
    { "type": "text", "id": "note", "label": "Center note", "default": "Custom hats, made by hand" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(732) 757-7567" },
    {
      "type": "select",
      "id": "timezone",
      "label": "Shop time zone",
      "default": "America/New_York",
      "options": [
        { "value": "America/New_York", "label": "Eastern" },
        { "value": "America/Chicago", "label": "Central" },
        { "value": "America/Denver", "label": "Mountain" },
        { "value": "America/Los_Angeles", "label": "Pacific" }
      ]
    },
    { "type": "paragraph", "content": "Shop hours power the live open/closed line. Use 24-hour times like 11-18 or 10:30-17. Leave a day empty if closed." },
    { "type": "text", "id": "hours_0", "label": "Sunday", "default": "12-17" },
    { "type": "text", "id": "hours_1", "label": "Monday" },
    { "type": "text", "id": "hours_2", "label": "Tuesday" },
    { "type": "text", "id": "hours_3", "label": "Wednesday", "default": "11-18" },
    { "type": "text", "id": "hours_4", "label": "Thursday", "default": "11-18" },
    { "type": "text", "id": "hours_5", "label": "Friday", "default": "11-18" },
    { "type": "text", "id": "hours_6", "label": "Saturday", "default": "10-18" }
  ]
}
{% endschema %}
