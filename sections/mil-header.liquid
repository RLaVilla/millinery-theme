{% doc %}
  The Millinery — letterhead header.
  Live local date/time + city on the left, hand-signed wordmark, typed nav with
  radio-dot active state, shop address top right. Nav sticks on scroll.
{% enddoc %}
{%- liquid
  assign menu = section.settings.menu
  assign cart_label = section.settings.cart_label | default: 'Cart'
-%}
<header class="mil-header mil-section mil-wrap" data-mil-header>
  <div class="mil-header__top">
    <p class="mil-header__dateline mil-caps">
      <span>{{ section.settings.city }}.</span>
      <time data-mil-clock data-tz="{{ section.settings.timezone }}"></time>
    </p>

    <nav class="mil-header__bar" data-mil-bar aria-label="Primary">
      <div class="mil-header__utils mil-caps">
        <a class="mil-link" href="{{ routes.search_url }}">Search</a>
        <a class="mil-link" href="{{ routes.cart_url }}">
          {{- cart_label }} [<span data-mil-cart-count>{{ cart.item_count }}</span>]
        </a>
      </div>
      <ul class="mil-header__menu mil-caps" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign is_active = false
            if link.active or link.child_active
              assign is_active = true
            endif
          -%}
          <li>
            <a
              href="{{ link.url }}"
              class="mil-header__navlink{% if is_active %} is-active{% endif %}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
              <span class="mil-dot" aria-hidden="true"></span>
              <span class="mil-link">{{ link.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <address class="mil-header__address mil-caps">
      {{- section.settings.address | newline_to_br -}}
      {%- if section.settings.phone != blank -%}
        <br><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' }}">
          {{- section.settings.phone -}}
        </a>
      {%- endif -%}
    </address>
  </div>

  <a href="{{ routes.root_url }}" class="mil-header__logo" aria-label="{{ shop.name }}">
    {%- if section.settings.logo != blank -%}
      <span class="mil-header__logo-img" style="--mil-logo-h: {{ section.settings.logo_height }}px;">
        {{- section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name -}}
      </span>
    {%- else -%}
      <span class="mil-header__wordmark" style="font-size: {{ section.settings.logo_height }}px;">
        {{- section.settings.wordmark | default: shop.name -}}
      </span>
    {%- endif -%}
  </a>
</header>

<style>
  .mil-header {
    position: relative;
    padding-block: 40px 56px;
    color: var(--mil-ink);
    background: var(--mil-paper);
  }
  .mil-header__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 24px;
  }
  .mil-header__dateline,
  .mil-header__address {
    margin: 0;
    font-size: var(--mil-text-sm);
    font-style: normal;
    line-height: 1.5;
    color: var(--mil-faint);
  }
  .mil-header__address { justify-self: end; text-align: left; }
  .mil-header__address a { color: inherit; text-decoration: none; }
  .mil-header__dateline time { margin-left: 0.4em; }

  .mil-header__bar {
    display: flex;
    align-items: center;
    gap: clamp(24px, 6vw, 120px);
    padding: 12px 20px;
    margin-top: -12px;
    background: transparent;
    transition: background 0.25s;
  }
  .mil-header__bar.is-stuck {
    position: fixed;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0;
    z-index: 50;
    background: var(--mil-tile);
  }
  .mil-header__utils { display: flex; gap: 16px; white-space: nowrap; }
  .mil-header__menu {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-header__navlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .mil-dot {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
    flex: none;
  }
  .mil-header__navlink.is-active .mil-dot { background: currentColor; box-shadow: inset 0 0 0 1.5px var(--mil-paper); }
  .mil-header__navlink:hover { color: var(--mil-accent); }

  .mil-header__logo {
    display: inline-block;
    margin-top: 28px;
    margin-left: clamp(0px, 9vw, 150px);
    color: var(--mil-accent);
    text-decoration: none;
    line-height: 1;
  }
  .mil-header__logo-img img { display: block; height: var(--mil-logo-h); width: auto; }
  .mil-header__wordmark {
    font-family: var(--mil-sign);
    font-weight: 400;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .mil-header { padding-block: 20px 32px; }
    .mil-header__top { grid-template-columns: 1fr; gap: 14px; }
    .mil-header__address { display: none; }
    .mil-header__bar { flex-wrap: wrap; gap: 12px 24px; padding: 0; margin: 0; }
    .mil-header__bar.is-stuck {
      top: 0;
      left: 0;
      right: 0;
      transform: none;
      padding: 12px var(--mil-gutter);
    }
    .mil-header__menu { gap: 18px; flex-wrap: wrap; }
    .mil-header__logo { margin: 20px 0 0; }
  }
</style>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || root.dataset.milReady) return;
    root.dataset.milReady = '1';

    // Live dateline: THU 19 NOV. 7:05PM in the shop's own time zone
    const clock = root.querySelector('[data-mil-clock]');
    const tz = clock?.dataset.tz || 'America/New_York';
    const tick = () => {
      const d = new Date();
      const part = (o) => new Intl.DateTimeFormat('en-US', { timeZone: tz, ...o }).format(d);
      clock.textContent =
        `${part({ weekday: 'short' })} ${part({ day: 'numeric' })} ${part({ month: 'short' })}. ` +
        part({ hour: 'numeric', minute: '2-digit' }).replace(' ', '');
    };
    if (clock) { tick(); setInterval(tick, 15000); }

    // Nav pins to the top once you scroll past it
    const bar = root.querySelector('[data-mil-bar]');
    if (bar) {
      const spacer = document.createElement('div');
      bar.after(spacer);
      spacer.style.display = 'none';
      new IntersectionObserver(([e]) => {
        const stuck = !e.isIntersecting && e.boundingClientRect.top < 0;
        if (stuck && !bar.classList.contains('is-stuck')) {
          spacer.style.cssText = `width:${bar.offsetWidth}px;height:${bar.offsetHeight}px`;
        }
        bar.classList.toggle('is-stuck', stuck);
        spacer.style.display = stuck ? 'block' : 'none';
      }, { rootMargin: '-40px 0px 0px 0px' }).observe(root.querySelector('.mil-header__top'));
    }

    // Keep CART [n] in sync after any add/change, whatever triggered it
    const count = root.querySelector('[data-mil-cart-count]');
    const refresh = () =>
      fetch(`${window.Shopify?.routes?.root || '/'}cart.js`)
        .then((r) => r.json())
        .then((c) => { if (count) count.textContent = c.item_count; })
        .catch(() => {});
    if ('PerformanceObserver' in window) {
      new PerformanceObserver((list) => {
        if (list.getEntries().some((e) => /\/cart\/(add|change|update|clear)/.test(e.name))) refresh();
      }).observe({ type: 'resource', buffered: false });
    }
    window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
  })();
</script>

{% schema %}
{
  "name": "Millinery header",
  "class": "mil-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo / signature image", "info": "Leave empty to use the hand-signed wordmark below." },
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "default": "The Millinery" },
    { "type": "range", "id": "logo_height", "label": "Logo size", "min": 24, "max": 120, "step": 2, "unit": "px", "default": 56 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" },
    { "type": "header", "content": "Letterhead" },
    { "type": "text", "id": "city", "label": "City line", "default": "Keansburg, NJ" },
    {
      "type": "select",
      "id": "timezone",
      "label": "Clock time zone",
      "default": "America/New_York",
      "options": [
        { "value": "America/New_York", "label": "Eastern" },
        { "value": "America/Chicago", "label": "Central" },
        { "value": "America/Denver", "label": "Mountain" },
        { "value": "America/Los_Angeles", "label": "Pacific" }
      ]
    },
    { "type": "textarea", "id": "address", "label": "Shop address", "default": "The Millinery\n123 Main St\nKeansburg, NJ 07734" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "732.000.0000" }
  ]
}
{% endschema %}
