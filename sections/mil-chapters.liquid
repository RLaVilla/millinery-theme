{% doc %}
  The Millinery — how a hat gets made. Photo or silent looping clip per step,
  with a hang tag (NO. 01), serif title and a short line of copy.
{% enddoc %}
<div class="mil-steps mil-section mil-wrap" style="--mil-st-cols: {{ section.blocks.size | at_least: 1 }};">
  {%- if section.settings.heading != blank -%}
    <h2 class="mil-heading">
      {{- section.settings.heading -}}
      {%- if section.settings.kicker != blank -%}<small>{{ section.settings.kicker }}</small>{%- endif -%}
    </h2>
  {%- endif -%}
  <ol class="mil-steps__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
        assign n = forloop.index | prepend: '0' | slice: -2, 2
      -%}
      <li {{ block.shopify_attributes }}>
        <{{ tag }}
          class="mil-steps__item"
          {% if tag == 'a' %}
            href="{{ block.settings.link }}"
          {% endif %}
        >
          <span class="mil-steps__media mil-linen">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '900x'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: widths: '450, 700, 900, 1200', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mil-steps__ph' }}
            {%- endif -%}
          </span>
          <span class="mil-tag mil-steps__tag">No. {{ n }}</span>
          <span class="mil-steps__title">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="mil-steps__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </{{ tag }}>
      </li>
    {%- endfor -%}
  </ol>
</div>

<style>
  .mil-steps { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-steps__list {
    display: grid;
    grid-template-columns: repeat(var(--mil-st-cols), minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-steps__item { display: flex; flex-direction: column; align-items: flex-start; color: inherit; text-decoration: none; }
  .mil-steps__media {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .mil-steps__media img,
  .mil-steps__media video,
  .mil-steps__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s ease;
  }
  .mil-steps__ph { fill: var(--mil-faint); opacity: 0.25; }
  a.mil-steps__item:hover img,
  a.mil-steps__item:hover video { transform: scale(1.03); }
  .mil-steps__tag { color: var(--mil-accent); }
  .mil-steps__title { margin-top: 12px; font: 500 26px / 1.15 var(--mil-serif); }
  .mil-steps__text { margin-top: 6px; max-width: 34ch; color: var(--mil-faint); font-size: 16px; }
  a.mil-steps__item:hover .mil-steps__title { color: var(--mil-accent); }

  @media (max-width: 899px) {
    .mil-steps__list { grid-template-columns: 1fr; gap: 40px; }
    .mil-steps__media { aspect-ratio: 4 / 3; }
  }
</style>

{% schema %}
{
  "name": "Millinery process",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a hat is made" },
    { "type": "text", "id": "kicker", "label": "Small note beside heading", "default": "By hand, in Keansburg" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The fitting" },
        { "type": "textarea", "id": "text", "label": "Short description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (plays silently on loop)", "info": "Overrides the image." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Millinery process",
      "blocks": [
        { "type": "chapter", "settings": { "title": "The fitting" } },
        { "type": "chapter", "settings": { "title": "Choosing the felt" } },
        { "type": "chapter", "settings": { "title": "Shaping & finishing" } }
      ]
    }
  ]
}
{% endschema %}
