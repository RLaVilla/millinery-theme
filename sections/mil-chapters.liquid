{% comment %}
  The Millinery — how a hat gets made. Photo or silent looping clip per step,
  with a hang tag (NO. 01), serif title and a short line of copy.
{% endcomment %}
<div class="mil-steps mil-section mil-wrap" style="--mil-st-cols: {{ section.blocks.size | at_least: 1 }};">
  {%- if section.settings.heading != blank -%}
    <h2 class="mil-heading">
      {{- section.settings.heading -}}
      {%- if section.settings.kicker != blank -%}<small>{{ section.settings.kicker }}</small>{%- endif -%}
    </h2>
  {%- endif -%}
  {%- if section.settings.layout == 'feature' and section.blocks.size > 0 -%}
    <div class="mil-feat" data-mil-feat data-auto="{{ section.settings.autoplay }}">
      <div class="mil-feat__stage mil-linen">
        {%- for block in section.blocks -%}
          {%- assign n = forloop.index | prepend: '0' | slice: -2, 2 -%}
          <figure
            class="mil-feat__slide{% if forloop.first %} is-on{% endif %}"
            data-i="{{ forloop.index0 }}"
            id="MilFeat-{{ section.id }}-{{ forloop.index0 }}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: forloop.first, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x', preload: 'metadata' }}
            {%- elsif block.settings.image != blank -%}
              {%- liquid
                assign load = 'lazy'
                if forloop.first
                  assign load = 'eager'
                endif
              -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: widths: '800, 1200, 1600, 2200', sizes: '100vw', loading: load, alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mil-steps__ph' }}
            {%- endif -%}
            <figcaption class="mil-feat__card">
              <span class="mil-tag mil-steps__tag">No. {{ n }}</span>
              <span class="mil-feat__title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="mil-feat__text">{{ block.settings.text }}</span>{%- endif -%}
              {%- if block.settings.link != blank -%}<a class="mil-link mil-feat__more" href="{{ block.settings.link }}">Learn more</a>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      <div class="mil-feat__thumbs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign n = forloop.index | prepend: '0' | slice: -2, 2 -%}
          <button
            type="button"
            class="mil-feat__thumb{% if forloop.first %} is-on{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="MilFeat-{{ section.id }}-{{ forloop.index0 }}"
            data-i="{{ forloop.index0 }}"
          >
            <span class="mil-feat__thumb-img mil-linen">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '', sizes: '200px' }}
              {%- elsif block.settings.video != blank -%}
                {{ block.settings.video.preview_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span class="mil-feat__thumb-label">
              <span class="mil-meta">No. {{ n }}</span>
              <span class="mil-feat__thumb-title">{{ block.settings.title }}</span>
            </span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
  <ol class="mil-steps__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
        assign n = forloop.index | prepend: '0' | slice: -2, 2
      -%}
      <li {{ block.shopify_attributes }}>
        <{{ tag }}
          class="mil-steps__item"
          {% if tag == 'a' %}
            href="{{ block.settings.link }}"
          {% endif %}
        >
          <span class="mil-steps__media mil-linen">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '900x'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: widths: '450, 700, 900, 1200', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mil-steps__ph' }}
            {%- endif -%}
          </span>
          <span class="mil-tag mil-steps__tag">No. {{ n }}</span>
          <span class="mil-steps__title">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="mil-steps__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </{{ tag }}>
      </li>
    {%- endfor -%}
  </ol>
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }} { --mil-pt: calc({{ section.settings.pad_top }}px * var(--mil-space, 1)); --mil-pb: calc({{ section.settings.pad_bottom }}px * var(--mil-space, 1)); }
  .mil-steps { padding-block: var(--mil-pt) var(--mil-pb); }
  .mil-steps__list {
    display: grid;
    grid-template-columns: repeat(var(--mil-st-cols), minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-steps__item { display: flex; flex-direction: column; align-items: flex-start; color: inherit; text-decoration: none; }
  .mil-steps__media {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .mil-steps__media img,
  .mil-steps__media video,
  .mil-steps__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s ease;
  }
  .mil-steps__ph { fill: var(--mil-faint); opacity: 0.25; }
  a.mil-steps__item:hover img,
  a.mil-steps__item:hover video { transform: scale(1.03); }
  .mil-steps__tag { color: var(--mil-accent); }
  .mil-steps__title { margin-top: 12px; font: 500 26px / 1.15 var(--mil-serif); }
  .mil-steps__text { margin-top: 6px; max-width: 34ch; color: var(--mil-faint); font-size: 16px; }
  a.mil-steps__item:hover .mil-steps__title { color: var(--mil-accent); }

  @media (max-width: 899px) {
    .mil-steps__list { grid-template-columns: 1fr; gap: 40px; }
    .mil-steps__media { aspect-ratio: 4 / 3; }
  }
  /* Feature layout: big stage + numbered thumbnails */
  .mil-feat__stage { position: relative; aspect-ratio: 16 / 9; max-height: 82vh; width: 100%; overflow: hidden; }
  .mil-feat__slide { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; transition: opacity 0.6s ease, visibility 0.6s; }
  .mil-feat__slide.is-on { opacity: 1; visibility: visible; }
  .mil-feat__slide > img,
  .mil-feat__slide > video,
  .mil-feat__slide > .mil-steps__ph { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mil-feat__slide > img { mix-blend-mode: normal; transform: scale(1.02); transition: transform 6s ease; }
  .mil-feat__slide.is-on > img { transform: scale(1); }
  .mil-feat__card {
    position: absolute;
    left: clamp(14px, 2.4vw, 32px);
    bottom: clamp(14px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: min(420px, calc(100% - 28px));
    padding: 18px 22px 18px;
    background: color-mix(in srgb, var(--mil-paper) 94%, transparent);
    border: 3px double var(--mil-ink);
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.5s 0.15s ease, transform 0.5s 0.15s ease;
  }
  .mil-feat__slide.is-on .mil-feat__card { opacity: 1; transform: none; }
  .mil-feat__title { font: 500 clamp(24px, 2.6vw, 34px) / 1.1 var(--mil-serif); }
  .mil-feat__text { font-size: 16px; line-height: 1.5; color: color-mix(in srgb, var(--mil-ink) 78%, transparent); }
  .mil-feat__more { font-size: 15px; }

  .mil-feat__thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(10px, 1.6vw, 20px);
    margin-top: 14px;
  }
  .mil-feat__thumb {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 6px;
    border: 1px solid var(--mil-rule);
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .mil-feat__thumb:hover { border-color: var(--mil-faint); }
  .mil-feat__thumb.is-on { border-color: var(--mil-ink); background: var(--mil-tile); }
  .mil-feat__thumb-img { display: block; aspect-ratio: 1; overflow: hidden; }
  .mil-feat__thumb-img img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; opacity: 0.55; transition: opacity 0.25s; }
  .mil-feat__thumb.is-on .mil-feat__thumb-img img,
  .mil-feat__thumb:hover .mil-feat__thumb-img img { opacity: 1; }
  .mil-feat__thumb-label { display: flex; flex-direction: column; gap: 3px; }
  .mil-feat__thumb-label .mil-meta { color: var(--mil-accent); }
  .mil-feat__thumb-title { font: 500 18px / 1.15 var(--mil-serif); }
  .mil-feat__thumb:focus-visible { outline: 1px solid var(--mil-ink); outline-offset: 2px; }

  @media (max-width: 899px) {
    .mil-feat { margin-inline: calc(var(--mil-gutter) * -1); }
    .mil-feat__stage { aspect-ratio: 4 / 5; max-height: none; }
    .mil-feat__card { left: 12px; right: 12px; bottom: 12px; max-width: none; padding: 14px 16px; }
    .mil-feat__thumbs {
      grid-auto-columns: 62%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: var(--mil-gutter);
    }
    .mil-feat__thumb { scroll-snap-align: start; grid-template-columns: 56px minmax(0, 1fr); }
    .mil-feat__thumb-title { font-size: 16px; }
  }
</style>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    const feat = root?.querySelector?.('[data-mil-feat]');
    if (!feat || feat.dataset.milReady) return;
    feat.dataset.milReady = '1';
    const slides = [...feat.querySelectorAll('.mil-feat__slide')];
    const thumbs = [...feat.querySelectorAll('.mil-feat__thumb')];
    let cur = 0;
    let timer = null;
    const show = (i, focus) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === cur;
        s.classList.toggle('is-on', on);
        s.toggleAttribute('aria-hidden', !on);
        const v = s.querySelector('video');
        if (v) on ? v.play().catch(() => {}) : v.pause();
        if (on) s.querySelector('img')?.setAttribute('loading', 'eager');
      });
      thumbs.forEach((t, k) => {
        t.classList.toggle('is-on', k === cur);
        t.setAttribute('aria-selected', String(k === cur));
      });
      if (focus) thumbs[cur].focus();
      thumbs[cur].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    thumbs.forEach((t, k) => t.addEventListener('click', () => { show(k); restart(); }));
    feat.addEventListener('keydown', (e) => {
      if (!e.target.closest('.mil-feat__thumb')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1, true); restart(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1, true); restart(); }
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const auto = feat.dataset.auto === 'true' && !reduce && slides.length > 1;
    function restart() {
      clearInterval(timer);
      if (auto) timer = setInterval(() => show(cur + 1), 6500);
    }
    if (auto) {
      feat.addEventListener('pointerenter', () => clearInterval(timer));
      feat.addEventListener('pointerleave', restart);
      feat.addEventListener('focusin', () => clearInterval(timer));
      new IntersectionObserver(([e]) => (e.isIntersecting ? restart() : clearInterval(timer))).observe(feat);
    }
    // In the theme editor, selecting a block shows its slide
    document.addEventListener('shopify:block:select', (e) => {
      const i = slides.findIndex((s) => s.contains(e.target) || s === e.target);
      if (i > -1) { clearInterval(timer); show(i); }
    });
  })();
</script>

{% schema %}
{
  "name": "Millinery process",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a hat is made" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "feature",
      "options": [
        { "value": "feature", "label": "Feature: big photo + numbered thumbnails" },
        { "value": "grid", "label": "Grid: steps side by side" }
      ]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-advance (feature layout)", "default": true },
    { "type": "text", "id": "kicker", "label": "Small note beside heading", "default": "By hand, in Keansburg" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The fitting" },
        { "type": "textarea", "id": "text", "label": "Short description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (plays silently on loop)", "info": "Overrides the image." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Millinery process",
      "blocks": [
        { "type": "chapter", "settings": { "title": "The fitting" } },
        { "type": "chapter", "settings": { "title": "Choosing the felt" } },
        { "type": "chapter", "settings": { "title": "Shaping & finishing" } }
      ]
    }
  ]
}
{% endschema %}
