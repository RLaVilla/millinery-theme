{% doc %}
  The Millinery — "chapters": a row of faded photos or looping clips captioned
  I: THE FITTING, II: CHOOSING THE FELT, III: SHAPING… Each can link somewhere.
{% enddoc %}
{%- assign roman = 'I,II,III,IV,V,VI' | split: ',' -%}
<div
  class="mil-chapters mil-section mil-wrap{% if section.settings.faded %} is-faded{% endif %}"
  style="--mil-ch-cols: {{ section.blocks.size | at_least: 1 }};"
>
  {%- if section.settings.heading != blank -%}
    <p class="mil-label">{{ section.settings.heading }}</p>
  {%- endif -%}
  <ol class="mil-chapters__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <li {{ block.shopify_attributes }}>
        <{{ tag }}
          class="mil-chapters__item"
          {% if tag == 'a' %}
            href="{{ block.settings.link }}"
          {% endif %}
        >
          <span class="mil-chapters__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  image_size: '900x'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: widths: '450, 700, 900, 1200', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mil-chapters__ph' }}
            {%- endif -%}
          </span>
          <span class="mil-chapters__caption mil-caps">
            {{- roman[forloop.index0] }}: {{ block.settings.title -}}
          </span>
        </{{ tag }}>
      </li>
    {%- endfor -%}
  </ol>
</div>

<style>
  .mil-chapters { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-chapters__list {
    display: grid;
    grid-template-columns: repeat(var(--mil-ch-cols), minmax(0, 1fr));
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-chapters__item { display: block; color: inherit; text-decoration: none; }
  .mil-chapters__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mil-tile);
  }
  .mil-chapters__media img,
  .mil-chapters__media video,
  .mil-chapters__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.6s ease, transform 1.2s ease;
  }
  .mil-chapters__ph { fill: var(--mil-faint); opacity: 0.3; }
  .is-faded .mil-chapters__media img,
  .is-faded .mil-chapters__media video {
    filter: grayscale(1) contrast(0.85) brightness(1.15) opacity(0.75);
  }
  .is-faded a.mil-chapters__item:hover img,
  .is-faded a.mil-chapters__item:hover video { filter: none; }
  a.mil-chapters__item:hover img,
  a.mil-chapters__item:hover video { transform: scale(1.02); }
  .mil-chapters__caption { display: block; padding-top: 12px; }
  a.mil-chapters__item:hover .mil-chapters__caption { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 899px) {
    .mil-chapters__list { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

{% schema %}
{
  "name": "Millinery chapters",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Label" },
    { "type": "checkbox", "id": "faded", "label": "Faded black & white (color on hover)", "default": true },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 200 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The fitting" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (plays silently on loop)", "info": "Overrides the image." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Millinery chapters",
      "blocks": [
        { "type": "chapter", "settings": { "title": "The fitting" } },
        { "type": "chapter", "settings": { "title": "Choosing the felt" } },
        { "type": "chapter", "settings": { "title": "Shaping" } }
      ]
    }
  ]
}
{% endschema %}
