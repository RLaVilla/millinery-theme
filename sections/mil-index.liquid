{% doc %}
  The Millinery — numbered index. Paper thumbnails down the left, a typed
  numbered list in the middle, one big photo on the right that changes as you
  hover a name or thumbnail. The big photo is each product's 2nd image
  (a worn/lifestyle shot), falling back to its main image.
{% enddoc %}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign products = source.products
  assign limit = section.settings.limit
-%}
<div class="mil-index mil-section mil-wrap" data-mil-index>
  {%- if section.settings.heading != blank -%}
    <p class="mil-label">{{ section.settings.heading }}</p>
  {%- endif -%}

  {%- if source != blank -%}
    <div class="mil-index__layout">
      <ol class="mil-index__thumbs" role="list">
        {%- for product in products limit: limit -%}
          <li>
            <a href="{{ product.url }}" class="mil-index__thumb" data-i="{{ forloop.index0 }}">
              <span class="mil-paper">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media.preview_image
                    | image_url: width: 400
                    | image_tag: widths: '200, 300, 400', sizes: '160px', loading: 'lazy', alt: product.title
                  }}
                {%- endif -%}
              </span>
              <span class="mil-index__n">{{ forloop.index }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>

      <ol class="mil-index__names" role="list">
        {%- for product in products limit: limit -%}
          <li>
            <a href="{{ product.url }}" class="mil-index__name{% if forloop.first %} is-on{% endif %}" data-i="{{ forloop.index0 }}">
              <span class="mil-index__num">{{ forloop.index }}</span>
              <span>{{ product.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>

      <div class="mil-index__stage">
        {%- for product in products limit: limit -%}
          {%- assign hero = product.media[1].preview_image | default: product.featured_media.preview_image -%}
          {%- if hero -%}
            <div class="mil-index__hero" data-i="{{ forloop.index0 }}">
              {{
                hero
                | image_url: width: 1400
                | image_tag:
                  widths: '600, 900, 1200, 1400',
                  sizes: '(min-width: 900px) 40vw, 100vw',
                  loading: 'lazy',
                  alt: product.title
              }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <p class="mil-caps" style="color: var(--mil-faint);">Pick a collection in the theme editor.</p>
  {%- endif -%}
</div>

<style>
  .mil-index { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-index__layout {
    display: grid;
    grid-template-columns: minmax(120px, 160px) 1fr minmax(180px, 240px) minmax(0, 2.6fr);
    gap: 24px;
    align-items: start;
  }
  .mil-index__layout > .mil-index__names { grid-column: 3; }
  .mil-index__layout > .mil-index__stage { grid-column: 4; }
  .mil-index ol { list-style: none; margin: 0; padding: 0; }

  .mil-index__thumbs { display: grid; gap: 4px; }
  .mil-index__thumb {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .mil-index__thumb .mil-paper { display: block; aspect-ratio: 4 / 5; overflow: hidden; }
  .mil-index__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10%;
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .mil-index__thumb.is-on img { opacity: 1; }

  .mil-index__name {
    display: flex;
    gap: 12px;
    padding: 1px 0;
    color: var(--mil-faint);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mil-index__name.is-on,
  .mil-index__name:hover { color: var(--mil-ink); }
  .mil-index__num { min-width: 1.6em; text-align: right; }

  .mil-index__stage {
    position: sticky;
    top: 110px;
    display: grid;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--mil-tile);
  }
  .mil-index__hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mil-index__hero {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .mil-index__hero.is-on { opacity: 1; }

  @media (max-width: 899px) {
    .mil-index__layout { grid-template-columns: 1fr; }
    .mil-index__layout > .mil-index__names,
    .mil-index__layout > .mil-index__stage { grid-column: auto; }
    .mil-index__thumbs { display: none; }
    .mil-index__stage { position: relative; top: 0; order: -1; }
  }
</style>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root?.matches('[data-mil-index]') || root.dataset.milReady) return;
    root.dataset.milReady = '1';
    const groups = ['.mil-index__thumb', '.mil-index__name', '.mil-index__hero'].map((s) => [
      ...root.querySelectorAll(s),
    ]);
    const show = (i) => {
      groups.forEach((els) => els.forEach((el) => el.classList.toggle('is-on', el.dataset.i === String(i))));
      const hero = groups[2].find((el) => el.dataset.i === String(i));
      hero?.querySelector('img')?.setAttribute('loading', 'eager');
    };
    root.addEventListener('pointerover', (e) => {
      const t = e.target.closest('[data-i]');
      if (t && root.contains(t)) show(t.dataset.i);
    });
    root.addEventListener('focusin', (e) => {
      const t = e.target.closest('[data-i]');
      if (t) show(t.dataset.i);
    });
    show(0);
  })();
</script>

{% schema %}
{
  "name": "Millinery numbered index",
  "settings": [
    { "type": "text", "id": "heading", "label": "Label", "default": "Signature hats" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 3, "max": 16, "step": 1, "default": 12 },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 240, "step": 8, "unit": "px", "default": 160 }
  ],
  "presets": [{ "name": "Millinery numbered index" }]
}
{% endschema %}
