{% comment %}
  The Millinery — product grid on linen tiles.
  On a collection page it shows that collection (with pagination and an optional
  row of hang-tag category links). Anywhere else it shows the picked collection.
{% endcomment %}
{%- liquid
  assign source = collection
  if template.name != 'collection' or source == blank
    assign source = section.settings.collection | default: collections.all
  endif
  assign per_page = section.settings.per_page
  assign columns = section.settings.columns
-%}
<div class="mil-grid mil-section mil-wrap" style="--mil-cols: {{ columns }};">
  {%- if template.name == 'collection' and section.settings.index_menu != blank -%}
    <nav class="mil-grid__index" aria-label="Categories">
      <a class="mil-tag{% if collection.handle == 'all' %} is-on{% endif %}" href="{{ routes.all_products_collection_url }}">Shop all</a>
      {%- for group in section.settings.index_menu.links -%}
        <a class="mil-tag{% if group.active %} is-on{% endif %}" href="{{ group.url }}">{{ group.title }}</a>
        {%- for child in group.links -%}
          <a class="mil-tag{% if child.active %} is-on{% endif %}" href="{{ child.url }}">{{ child.title }}</a>
        {%- endfor -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- if source != blank -%}
    {%- paginate source.products by per_page -%}
      <h2 class="mil-heading">
        {{- section.settings.heading | default: source.title -}}
        <small>{{ source.products_count }} {% if source.products_count == 1 %}piece{% else %}pieces{% endif %}</small>
      </h2>

      <ul class="mil-grid__list" role="list">
        {%- for product in source.products -%}
          {%- liquid
            assign lazy = true
            if forloop.index <= columns
              assign lazy = false
            endif
          -%}
          <li>{% render 'mil-card', product: product, lazy: lazy %}</li>
        {%- else -%}
          <li class="mil-grid__empty mil-meta">Nothing here yet.</li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 and template.name == 'collection' -%}
        <nav class="mil-grid__pages mil-meta" aria-label="Pages">
          {%- if paginate.previous -%}<a class="mil-link" href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="mil-link" href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
        </nav>
      {%- elsif template.name != 'collection' and source.products_count > per_page -%}
        <p class="mil-grid__more mil-meta"><a class="mil-link" href="{{ source.url }}">View all</a></p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <h2 class="mil-heading">{{ section.settings.heading | default: 'In the shop' }}</h2>
    <ul class="mil-grid__list" role="list">
      {%- for i in (1..columns) -%}
        <li>
          <span class="mil-card">
            <span class="mil-card__media mil-linen">{{ 'product-apparel-1' | placeholder_svg_tag: 'mil-card__img mil-card__placeholder' }}</span>
            <span class="mil-card__meta"><span class="mil-card__title">Hat name</span><span class="mil-card__price mil-meta">$600.00</span></span>
          </span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

<style>
  .mil-grid { padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px; }
  .mil-grid__index { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 56px; }
  .mil-grid__index .mil-tag { color: var(--mil-faint); text-decoration: none; }
  .mil-grid__index .mil-tag:hover,
  .mil-grid__index .mil-tag.is-on { color: var(--mil-ink); }
  .mil-grid__index .mil-tag.is-on { background: var(--mil-tile); }

  .mil-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--mil-cols), minmax(0, 1fr));
    gap: 48px clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mil-card { display: block; color: inherit; text-decoration: none; }
  .mil-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    outline: 1px solid var(--mil-rule);
    outline-offset: -1px;
  }
  .mil-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 9%;
    transition: opacity 0.5s ease, transform 0.8s ease;
  }
  .mil-card:hover .mil-card__img { transform: scale(1.03); }
  .mil-card__img--alt { opacity: 0; }
  .mil-card:hover .mil-card__img--alt { opacity: 1; }
  .mil-card:hover .mil-card__img:not(.mil-card__img--alt):has(+ .mil-card__img--alt) { opacity: 0; }
  .mil-card__placeholder { fill: var(--mil-faint); opacity: 0.3; }
  .mil-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 14px;
    border-bottom: 1px solid var(--mil-rule);
    padding-bottom: 10px;
  }
  .mil-card__title { font: 500 19px / 1.2 var(--mil-serif); }
  .mil-card__price { white-space: nowrap; color: var(--mil-faint); }
  .mil-card:hover .mil-card__title { color: var(--mil-accent); }
  .mil-grid__pages, .mil-grid__more { display: flex; justify-content: center; gap: 32px; margin-top: 64px; }
  .mil-grid__more a, .mil-grid__pages a { color: inherit; }
  .mil-grid__empty { grid-column: 1 / -1; padding: 80px 0; text-align: center; }

  @media (max-width: 899px) {
    .mil-grid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; }
    .mil-card__meta { flex-direction: column; gap: 2px; }
    .mil-card__title { font-size: 16px; }
  }
</style>

{% schema %}
{
  "name": "Millinery product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Label", "info": "Leave empty on collection pages to show the product count." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used everywhere except collection pages." },
    { "type": "link_list", "id": "index_menu", "label": "Category index menu", "info": "Collection pages only. Shown as a row of tags above the grid." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "per_page", "label": "Products shown", "min": 3, "max": 48, "step": 3, "default": 24 },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "Millinery product grid" }]
}
{% endschema %}
