{% comment %}
  The Millinery — "Book a fitting" landing hero for paid traffic.
  Headline, three quick reassurances, photo, and a request form that emails
  the shop (Shopify contact form). Optional: paste a booking embed (Calendly,
  Square, Acuity…) to replace the form. Adds a sticky Book / Call bar on mobile
  and fires a "fitting_request" event (+ Meta "Schedule" if fbq is on the page).
{% endcomment %}
{%- liquid
  assign phone_digits = section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
  assign form_id = 'MilBooking-' | append: section.id
-%}
<div class="mil-book mil-section mil-wrap" id="book">
  <div class="mil-book__intro">
    {%- if section.settings.tag != blank -%}
      <span class="mil-tag mil-book__tag">{{ section.settings.tag }}</span>
    {%- endif -%}
    <h1 class="mil-book__title">{{ section.settings.title }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="mil-book__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="mil-book__points" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="mil-book__media mil-linen">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'mil-book__ph' }}
      {%- endif -%}
    </div>
  </div>

  <div class="mil-book__card" id="book-form">
    {%- if section.settings.calendly_url != blank -%}
      {%- liquid
        assign cal_base = section.settings.calendly_url | split: '?' | first
        assign cal_colors = 'hide_gdpr_banner=1&hide_event_type_details=1&background_color=' | append: section.settings.cal_bg | append: '&text_color=' | append: section.settings.cal_text | append: '&primary_color=' | append: section.settings.cal_accent
        assign cal_colors = cal_colors | remove: '#'
      -%}
      <p class="mil-book__card-title mil-stamp">{{ section.settings.form_title }}</p>
      <div
        class="mil-book__calendly"
        data-mil-calendly
        data-base="{{ cal_base | escape }}"
        data-colors="{{ cal_colors | escape }}"
      >
        <noscript><a class="mil-btn" href="{{ cal_base }}" target="_blank" rel="noopener">Choose a time</a></noscript>
      </div>
      <p class="mil-book__fine mil-meta mil-book__cal-done" data-mil-cal-done hidden>Booked. Check your email for the confirmation.</p>
    {%- elsif section.settings.embed != blank -%}
      <p class="mil-book__card-title mil-stamp">{{ section.settings.form_title }}</p>
      <div class="mil-book__embed">{{ section.settings.embed }}</div>
    {%- else -%}
      {%- form 'contact', id: form_id, class: 'mil-book__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="mil-book__done" data-mil-booked>
            <p class="mil-book__card-title mil-stamp">Request received</p>
            <p class="mil-book__done-title">{{ section.settings.success_title }}</p>
            <p>{{ section.settings.success_text }}</p>
            {%- if section.settings.phone != blank -%}
              <a class="mil-btn mil-btn--ghost" href="tel:{{ phone_digits }}">Call {{ section.settings.phone }}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          <p class="mil-book__card-title mil-stamp">{{ section.settings.form_title }}</p>
          {%- if form.errors -%}
            <div class="mil-book__errors mil-meta" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="fitting-request">
          <input type="hidden" name="contact[Request]" value="Hat fitting">
          <input type="hidden" name="contact[Source]" value="" data-mil-source>

          <div
            class="mil-cal"
            data-mil-cal
            data-days="{{ section.settings.avail_days | escape }}"
            data-slots="{{ section.settings.slot_times | escape }}"
            data-lead="{{ section.settings.lead_days }}"
            data-weeks="{{ section.settings.weeks_ahead }}"
            data-blackout="{{ section.settings.blackout | strip_newlines | escape }}"
          >
            <div class="mil-cal__head">
              <button type="button" class="mil-cal__nav" data-mil-prev aria-label="Previous month">&larr;</button>
              <p class="mil-cal__month" data-mil-month aria-live="polite"></p>
              <button type="button" class="mil-cal__nav" data-mil-next aria-label="Next month">&rarr;</button>
            </div>
            <div class="mil-cal__dow mil-meta" aria-hidden="true">
              <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
            </div>
            <div class="mil-cal__grid" role="grid" data-mil-grid></div>
            <div class="mil-cal__slots" data-mil-slots hidden>
              <p class="mil-meta mil-cal__slots-title" data-mil-slots-title></p>
              <div class="mil-cal__slot-list" role="radiogroup" data-mil-slot-list></div>
            </div>
            <p class="mil-cal__picked" data-mil-picked hidden></p>
            <p class="mil-cal__error mil-meta" data-mil-cal-error role="alert" hidden>Pick a day and time for your fitting.</p>
            <input type="hidden" name="contact[Requested date]" data-mil-in-date>
            <input type="hidden" name="contact[Requested time]" data-mil-in-time>
          </div>

          <div class="mil-book__grid">
            <label class="mil-field mil-field--full">
              <span>Name</span>
              <input type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
            </label>
            <label class="mil-field">
              <span>Phone</span>
              <input type="tel" name="contact[phone]" autocomplete="tel" required value="{{ form.phone }}">
            </label>
            <label class="mil-field">
              <span>Email</span>
              <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
            </label>
            <label class="mil-field mil-field--full">
              <span>I'm interested in</span>
              <select name="contact[Interested in]">
                {%- assign options = section.settings.interests | newline_to_br | split: '<br />' -%}
                {%- for opt in options -%}
                  {%- assign o = opt | strip -%}
                  {%- if o != blank -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </label>
            <label class="mil-field mil-field--full">
              <span>Anything we should know? <em>(optional)</em></span>
              <textarea name="contact[body]" rows="3" placeholder="An occasion, a style you love, your hat size if you know it…">{{ form.body }}</textarea>
            </label>
          </div>

          <button type="submit" class="mil-btn mil-book__submit">{{ section.settings.button }}</button>
          {%- if section.settings.fine_print != blank -%}
            <p class="mil-book__fine mil-meta">{{ section.settings.fine_print }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- if section.settings.phone != blank -%}
      <p class="mil-book__or mil-meta">or</p>
      <a class="mil-btn mil-btn--ghost mil-book__call" href="tel:{{ phone_digits }}">Call {{ section.settings.phone }}</a>
      <p class="mil-book__alt">Prefer to text? <a class="mil-link" href="sms:{{ phone_digits }}">Send a text</a></p>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.sticky_bar -%}
  <div class="mil-book__bar" data-mil-bar hidden>
    <a class="mil-btn" href="#book-form">{{ section.settings.button }}</a>
    {%- if section.settings.phone != blank -%}
      <a class="mil-btn mil-btn--ghost" href="tel:{{ phone_digits }}">Call</a>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} { --mil-pt: calc({{ section.settings.pad_top }}px * var(--mil-space, 1)); --mil-pb: calc({{ section.settings.pad_bottom }}px * var(--mil-space, 1)); }
  .mil-book {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-block: var(--mil-pt) var(--mil-pb);
    scroll-margin-top: 80px;
  }
  .mil-book__tag { color: var(--mil-accent); }
  .mil-book__title { margin: 18px 0 14px; font: 500 clamp(40px, 5.2vw, 72px) / 1 var(--mil-serif); letter-spacing: -0.01em; }
  .mil-book__text { max-width: 44ch; font-size: 18px; line-height: 1.55; }
  .mil-book__text p { margin: 0 0 10px; }
  .mil-book__points { margin: 18px 0 28px; padding: 0; list-style: none; display: grid; gap: 8px; }
  .mil-book__points li { display: flex; gap: 10px; font-size: 17px; }
  .mil-book__points li::before { content: '\2715'; color: var(--mil-accent); font-size: 12px; transform: translateY(4px); }
  .mil-book__media { aspect-ratio: 5 / 4; overflow: hidden; }
  .mil-book__media img,
  .mil-book__ph { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mil-book__media img { mix-blend-mode: normal; }
  .mil-book__ph { fill: var(--mil-faint); opacity: 0.25; }

  .mil-book__card {
    position: sticky;
    top: 84px;
    padding: 26px clamp(18px, 2.4vw, 32px) 22px;
    border: 3px double var(--mil-ink);
    background: var(--mil-paper);
    scroll-margin-top: 80px;
  }
  .mil-book__card-title { margin: 0 0 18px; font-size: 13px; text-align: center; }
  .mil-book__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 14px; }
  .mil-field { display: flex; flex-direction: column; gap: 6px; }
  .mil-field--full { grid-column: 1 / -1; }
  .mil-field > span { font: 400 var(--mil-small) / 1.3 var(--mil-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  .mil-field em { font-style: normal; color: var(--mil-faint); text-transform: none; letter-spacing: 0; }
  .mil-field input,
  .mil-field select,
  .mil-field textarea {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--mil-rule);
    border-radius: 0;
    background: #fff;
    color: var(--mil-ink);
    font: 400 16px / 1.3 var(--mil-serif);
    appearance: none;
  }
  .mil-field select {
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 17px) 50%, calc(100% - 12px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 32px;
  }
  .mil-field input:focus,
  .mil-field select:focus,
  .mil-field textarea:focus { outline: 1px solid var(--mil-ink); outline-offset: 0; border-color: var(--mil-ink); }
  .mil-book__submit { width: 100%; margin-top: 18px; padding-block: 17px; }
  .mil-book__fine { margin: 10px 0 0; text-align: center; color: var(--mil-faint); }
  .mil-book__errors { margin-bottom: 14px; padding: 10px 12px; border: 1px solid var(--mil-accent); color: var(--mil-accent); }
  .mil-book__errors ul { margin: 0; padding-left: 16px; }
  .mil-book__alt { margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--mil-rule); text-align: center; font-size: 16px; }
  .mil-book__done { text-align: center; }
  .mil-book__done-title { margin: 0 0 8px; font: 500 30px / 1.1 var(--mil-serif); }
  .mil-book__done p { margin: 0 0 16px; }
  .mil-book__embed iframe { width: 100%; min-height: 640px; border: 0; }

  .mil-cal { margin-bottom: 22px; padding-bottom: 20px; border-bottom: 1px solid var(--mil-rule); }
  .mil-cal__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .mil-cal__month { margin: 0; font: italic 500 22px var(--mil-serif); }
  .mil-cal__nav { width: 36px; height: 36px; border: 1px solid var(--mil-rule); background: none; color: inherit; cursor: pointer; font: 400 16px var(--mil-mono); }
  .mil-cal__nav:hover:not([disabled]) { border-color: var(--mil-ink); }
  .mil-cal__nav[disabled] { opacity: 0.3; cursor: default; }
  .mil-cal__dow, .mil-cal__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; text-align: center; }
  .mil-cal__dow { margin-bottom: 4px; color: var(--mil-faint); }
  .mil-cal__day {
    aspect-ratio: 1;
    border: 1px solid transparent;
    background: none;
    color: var(--mil-faint);
    font: 400 16px var(--mil-serif);
    opacity: 0.45;
  }
  .mil-cal__day.is-open { opacity: 1; color: var(--mil-ink); border-color: var(--mil-rule); background: #fff; cursor: pointer; }
  .mil-cal__day.is-open:hover { border-color: var(--mil-ink); }
  .mil-cal__day.is-on { background: var(--mil-ink); border-color: var(--mil-ink); color: var(--mil-paper); }
  .mil-cal__day.is-today { text-decoration: underline; text-underline-offset: 3px; }
  .mil-cal__slots { margin-top: 16px; }
  .mil-cal__slots-title { margin: 0 0 8px; }
  .mil-cal__slot-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .mil-cal__slot {
    padding: 9px 12px;
    border: 1px solid var(--mil-rule);
    background: #fff;
    color: inherit;
    font: 400 12px var(--mil-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .mil-cal__slot:hover { border-color: var(--mil-ink); }
  .mil-cal__slot[aria-checked='true'] { background: var(--mil-ink); border-color: var(--mil-ink); color: var(--mil-paper); }
  .mil-cal__picked { margin: 14px 0 0; padding: 10px 12px; background: var(--mil-tile); font-size: 16px; }
  .mil-cal__picked strong { font-weight: 600; }
  .mil-cal__error { margin: 10px 0 0; color: var(--mil-accent); }
  .mil-book__call {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: 14px;
  }
  .mil-book__or { display: flex; align-items: center; gap: 12px; margin: 18px 0 0; color: var(--mil-faint); }
  .mil-book__or::before, .mil-book__or::after { content: ''; flex: 1; border-top: 1px solid var(--mil-rule); }

  .mil-book__calendly { min-height: 700px; margin: 0 -8px; }
  .mil-book__calendly iframe { width: 100%; min-height: 700px; border: 0; }
  .mil-book__cal-done { margin-top: 12px; color: var(--mil-ink); }
  .mil-book__bar { display: none; }

  @media (max-width: 899px) {
    .mil-book { grid-template-columns: 1fr; }
    .mil-book__card { position: static; }
    .mil-book__media { aspect-ratio: 4 / 3; order: 3; margin-top: 8px; }
    .mil-book__grid { grid-template-columns: 1fr; }
    .mil-book__bar:not([hidden]) {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      display: flex;
      gap: 8px;
      padding: 10px var(--mil-gutter) calc(10px + env(safe-area-inset-bottom));
      background: var(--mil-paper);
      border-top: 1px solid var(--mil-ink);
    }
    .mil-book__bar .mil-btn { flex: 1; }
    .mil-book__bar .mil-btn--ghost { flex: 0 0 34%; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('book');
    if (!root || root.dataset.milReady) return;
    root.dataset.milReady = '1';

    // Slot calendar: open weekdays + times from section settings
    const cal = root.querySelector('[data-mil-cal]');
    if (cal) {
      const DOW = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const openDays = new Set(
        cal.dataset.days.toLowerCase().split(/[\s,]+/).map((d) => DOW.indexOf(d.slice(0, 3))).filter((i) => i >= 0)
      );
      const slots = cal.dataset.slots.split(',').map((t) => t.trim()).filter(Boolean);
      const blackout = new Set((cal.dataset.blackout.match(/\d{4}-\d{2}-\d{2}/g) || []));
      const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const first = new Date(today); first.setDate(first.getDate() + (+cal.dataset.lead || 0));
      const last = new Date(today); last.setDate(last.getDate() + 7 * (+cal.dataset.weeks || 6));
      const isOpen = (d) => d >= first && d <= last && openDays.has(d.getDay()) && !blackout.has(iso(d));

      const grid = cal.querySelector('[data-mil-grid]');
      const monthEl = cal.querySelector('[data-mil-month]');
      const prev = cal.querySelector('[data-mil-prev]');
      const next = cal.querySelector('[data-mil-next]');
      const slotWrap = cal.querySelector('[data-mil-slots]');
      const slotList = cal.querySelector('[data-mil-slot-list]');
      const slotTitle = cal.querySelector('[data-mil-slots-title]');
      const picked = cal.querySelector('[data-mil-picked]');
      const err = cal.querySelector('[data-mil-cal-error]');
      const inDate = cal.querySelector('[data-mil-in-date]');
      const inTime = cal.querySelector('[data-mil-in-time]');
      const long = (d) => d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

      let view = new Date(first.getFullYear(), first.getMonth(), 1);
      let day = null;
      let time = '';

      const showPicked = () => {
        inDate.value = day ? `${long(day)} (${iso(day)})` : '';
        inTime.value = time;
        picked.hidden = !(day && time);
        if (day && time) {
          picked.innerHTML = `Your request: <strong>${long(day)} at ${time}</strong>`;
          err.hidden = true;
        }
      };

      const renderSlots = () => {
        slotWrap.hidden = !day;
        if (!day) return;
        slotTitle.textContent = `Times on ${long(day)}`;
        slotList.innerHTML = '';
        slots.forEach((t) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'mil-cal__slot';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', String(t === time));
          b.textContent = t;
          b.addEventListener('click', () => { time = t; renderSlots(); showPicked(); });
          slotList.append(b);
        });
      };

      const render = () => {
        monthEl.textContent = view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        prev.disabled = view <= new Date(first.getFullYear(), first.getMonth(), 1);
        next.disabled = new Date(view.getFullYear(), view.getMonth() + 1, 1) > last;
        grid.innerHTML = '';
        const lead = view.getDay();
        for (let i = 0; i < lead; i++) grid.append(document.createElement('span'));
        const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
        for (let n = 1; n <= days; n++) {
          const d = new Date(view.getFullYear(), view.getMonth(), n);
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'mil-cal__day';
          b.textContent = n;
          b.setAttribute('aria-label', long(d));
          if (+d === +today) b.classList.add('is-today');
          if (isOpen(d)) {
            b.classList.add('is-open');
            if (day && +d === +day) { b.classList.add('is-on'); b.setAttribute('aria-pressed', 'true'); }
            b.addEventListener('click', () => { day = d; time = ''; render(); renderSlots(); showPicked(); });
          } else {
            b.disabled = true;
          }
          grid.append(b);
        }
      };
      prev.addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); render(); });
      next.addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); render(); });

      // Jump to the first month that has an open day
      for (let i = 0; i < 3; i++) {
        const end = new Date(view.getFullYear(), view.getMonth() + 1, 0);
        let any = false;
        for (let d = new Date(view); d <= end; d.setDate(d.getDate() + 1)) if (isOpen(d)) { any = true; break; }
        if (any) break;
        view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      }
      render();

      cal.closest('form')?.addEventListener('submit', (e) => {
        if (!inDate.value || !inTime.value) {
          e.preventDefault();
          err.hidden = false;
          cal.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    // Record where the visit came from (utm_source / utm_campaign or fbclid) in the email
    const src = root.querySelector('[data-mil-source]');
    if (src) {
      const q = new URLSearchParams(location.search);
      try {
        const saved = sessionStorage.getItem('mil_src');
        const now = [q.get('utm_source'), q.get('utm_campaign')].filter(Boolean).join(' / ') || (q.get('fbclid') ? 'facebook' : '');
        if (now) sessionStorage.setItem('mil_src', now);
        src.value = now || saved || document.referrer || 'direct';
      } catch {
        src.value = document.referrer || 'direct';
      }
    }

    // Calendly: inline embed, UTMs passed through, conversion on a completed booking
    const calWrap = root.querySelector('[data-mil-calendly]');
    if (calWrap) {
      const q = new URLSearchParams(location.search);
      const keep = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const params = new URLSearchParams(calWrap.dataset.colors);
      keep.forEach((k) => { if (q.get(k)) params.set(k, q.get(k)); });
      if (!q.get('utm_source') && q.get('fbclid')) params.set('utm_source', 'facebook');
      const url = `${calWrap.dataset.base}?${params.toString()}`;
      const iframe = document.createElement('iframe');
      iframe.src = `${url}${url.includes('?') ? '&' : '?'}embed_domain=${location.hostname}&embed_type=Inline`;
      iframe.title = 'Choose a fitting time';
      iframe.loading = 'lazy';
      calWrap.append(iframe);

      let fired = false;
      window.addEventListener('message', (e) => {
        let host = '';
        try { host = new URL(e.origin).hostname; } catch { return; }
        if (!/(^|\.)calendly\.com$/.test(host)) return;
        const ev = e.data && e.data.event;
        if (ev === 'calendly.page_height' && e.data.payload?.height) {
          iframe.style.height = e.data.payload.height;
        }
        if (ev === 'calendly.event_scheduled' && !fired) {
          fired = true;
          try { window.Shopify?.analytics?.publish?.('fitting_request', { page: location.pathname, via: 'calendly' }); } catch {}
          if (typeof window.fbq === 'function') window.fbq('track', 'Schedule');
          root.querySelector('[data-mil-cal-done]')?.removeAttribute('hidden');
        }
      });
    }

    // Conversion: fire once when the thank-you state shows
    if (root.querySelector('[data-mil-booked]')) {
      try { window.Shopify?.analytics?.publish?.('fitting_request', { page: location.pathname }); } catch {}
      if (typeof window.fbq === 'function') window.fbq('track', 'Schedule');
      root.scrollIntoView({ block: 'start' });
    }

    // Mobile Book / Call bar appears once the form is off screen
    const bar = document.querySelector('[data-mil-bar]');
    const card = document.getElementById('book-form');
    if (bar && card && !root.querySelector('[data-mil-booked]')) {
      new IntersectionObserver(([e]) => { bar.hidden = e.isIntersecting; }).observe(card);
    }
  })();
</script>

